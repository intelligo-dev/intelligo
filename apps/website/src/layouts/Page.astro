---
/**
 * A secondary page (/product, /why, /ui and its galleries, /architecture): same
 * nav, a page header instead of the hero, and hairlines that run the full
 * width while every section's content sits in one centred 1280px column
 * (`.page-body` in global.css). Docs have their own layout.
 */
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import Base from "@/layouts/Base.astro";
import Footer from "@/components/footer.astro";
import { Nav } from "@/components/nav";
import { SITE } from "@/lib/site";

interface Props {
  path: string;
  tag?: string;
  title: string;
  lede?: string;
  description?: string;
  noindex?: boolean;
  /** A one-line title in place of the large header, for a page whose content is the point (/blocks, /components). */
  compact?: boolean;
  /** The gallery this page is, which puts the two galleries' tabs in its header, under /ui. */
  gallery?: "pages" | "components";
  /**
   * The `<title>`, when the heading is not what a reader would search for.
   * Without it the heading is the title, followed by the brand.
   */
  seoTitle?: string;
  /** JSON-LD for what this page is; without it, a `WebPage`. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const { path, tag, title, lede, description, noindex, compact, gallery, seoTitle, structuredData } = Astro.props;
const GALLERIES = [
  { id: "pages", href: "/blocks", label: "Pages" },
  { id: "components", href: "/components", label: "Components" },
];
const pageTitle = seoTitle ?? `${title.replace(/<br\s*\/?>/g, " ")} — ${SITE.brand}`;
const pageDescription = description ?? lede ?? SITE.description;
const pageData = structuredData ?? {
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: new URL(path, Astro.site).href,
  isPartOf: { "@type": "WebSite", name: SITE.brand, url: Astro.site?.href },
};
---
<Base title={pageTitle} description={pageDescription} noindex={noindex} structuredData={pageData}>
  <Nav client:load current={path} />
  <main id="main" class="page-body rails-full">
    <header class="xline">
      {compact ? (
        <div class="px-6 py-6 md:px-10">
          {gallery && (
            <nav aria-label="Intelligo UI" class="mb-3 flex items-center gap-1 text-[0.8rem]">
              <a href="/ui" class="mono mr-2 text-muted-foreground no-underline hover:text-foreground">intelligo ui /</a>
              {GALLERIES.map((g) => (
                <a
                  href={g.href}
                  aria-current={g.id === gallery ? "page" : undefined}
                  class:list={["rounded-lg px-2.5 py-1 no-underline transition-colors hover:bg-accent hover:text-foreground", g.id === gallery ? "bg-accent font-medium text-foreground" : "text-muted-foreground"]}
                >{g.label}</a>
              ))}
            </nav>
          )}
          {tag && <p class="tag mb-1" set:html={tag} />}
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h1 class="heading text-2xl font-medium tracking-[-0.01em]" set:html={title} />
            {lede && <p class="text-sm text-muted-foreground">{lede}</p>}
          </div>
        </div>
      ) : (
        <div class="px-6 pb-10 pt-14 md:px-10 md:pb-12 md:pt-20">
          <div class="section-head">
            {tag && <span class="tag">{tag}</span>}
            <h1 class="heading text-[clamp(1.9rem,3.4vw,3rem)] font-medium leading-[1.04] tracking-[-0.01em]" set:html={title} />
            {lede && <p class="mt-3 max-w-[60ch] text-[1rem] text-muted-foreground">{lede}</p>}
          </div>
        </div>
      )}
    </header>
    <slot />
    <section class="xline">
      <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-10 md:px-10 md:py-14">
        <p class="text-[0.95rem] text-muted-foreground">Ready to try it? Three commands and the app runs against a stub model.</p>
        <div class="flex items-center gap-2">
          <a href={SITE.github} class={cn(buttonVariants({ variant: "outline" }), "border-foreground/20")}>GitHub</a>
          <a href={SITE.docs} class={cn(buttonVariants({ variant: "outline" }), "border-foreground/20")}>Docs</a>
          <a href={SITE.start} class={buttonVariants()}>Get started</a>
        </div>
      </div>
    </section>
  </main>
  <div class="page-body rails-full"><Footer /></div>
</Base>
