---
import SectionHead from "@/components/section-head.astro";
import { InstallCommand } from "@/components/install-command";
import { REGISTRY_COUNT } from "@/lib/registry-items";
import { SITE } from "@/lib/site";

const cmd = `pnpm exec shadcn add ${SITE.registryBase}/team-settings.json`;

const PRINCIPLES = [
  ["UI becomes application source.", "Pages, components, states and thin actions land in your tree, rendered by your own shadcn primitives."],
  ["No runtime Intelligo UI dependency.", "Nothing on the page imports a framework UI package. Delete Intelligo tomorrow and the page still renders."],
  ["Business logic stays separated.", "An installed action parses, calls a typed service, maps the error. The invariants live in the packages, tested against a real database."],
  ["Registry updates stay available.", "Items are versioned with the packages; re-install to take an update, and doctor reports what you customised."],
];
---
<section id="ownership" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      n="04"
      tag="consumer-owned ui"
      title="Your UI is not our dependency."
      lede={`${REGISTRY_COUNT} page families arrive as source through a shadcn-compatible registry, while the business logic stays behind versioned services.`}
    />

    <div class="reveal mt-8 grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:gap-10">
      <div>
        <InstallCommand client:visible cmd={cmd} />

        <!-- the ownership flow -->
        <ol class="mt-4 border border-line-strong bg-paper-raised">
          {[
            ["intelligo registry", "intelligo.dev/r/team-settings.json — versioned with the packages", "ink"],
            ["application source", "app/[locale]/(app)/settings/team/page.tsx · components/team/*.tsx · actions.ts · messages/en/team-settings.json", "amber"],
            ["custom product ui", "edit anything; config and message files carry the variance, so most changes never touch a component", "settle"],
          ].map(([h, b, tone], i) => (
            <li class:list={["flex flex-col gap-1 px-4 py-3.5 sm:flex-row sm:gap-4", i > 0 && "border-t border-line"]}>
              <span class:list={["mono shrink-0 pt-0.5 text-[0.66rem] sm:w-[8.5rem] uppercase tracking-[0.08em]", tone === "amber" ? "text-amber" : tone === "settle" ? "text-settle" : "text-ink-faint"]}>
                {i > 0 && <span class="mr-1" aria-hidden="true">↓</span>}{h}
              </span>
              <span class="mono min-w-0 break-all text-[0.76rem] leading-relaxed text-ink-dim">{b}</span>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <ul class="border-t border-line">
          {PRINCIPLES.map(([h, b]) => (
            <li class="border-b border-line py-3.5">
              <div class="text-[0.98rem] font-semibold text-ink">{h}</div>
              <p class="mt-0.5 text-[0.88rem] text-ink-dim">{b}</p>
            </li>
          ))}
        </ul>

        <!-- the boundary inside an installed page -->
        <div class="mono mt-5 flex flex-wrap items-center gap-2 text-[0.74rem]">
          <span class="border border-line-strong px-2.5 py-1 text-ink">installed page</span>
          <span class="text-ink-faint" aria-hidden="true">→</span>
          <span class="border border-line-strong px-2.5 py-1 text-ink">thin action</span>
          <span class="text-ink-faint" aria-hidden="true">→</span>
          <span class="border border-amber bg-amber-soft px-2.5 py-1 text-amber">typed @intelligo-dev service</span>
        </div>
        <p class="mono mt-4 text-[0.72rem] text-ink-faint">
          <a href="/pages" class="hover:text-ink">Browse every page family →</a>
          <span aria-hidden="true"> · </span>
          <a href={`${SITE.adrs}/0010-registry-i18n-standard.md`} class="hover:text-ink">ADR-0010</a>
        </p>
      </div>
    </div>
  </div>
</section>
