---
import { render } from "astro:content";
import Docs from "@/layouts/Docs.astro";
import { docHref, orderedDocs, sectionTitle, type DocEntry } from "@/lib/docs-nav";

export async function getStaticPaths() {
  const docs = await orderedDocs();
  const link = (d?: DocEntry) => d && { href: docHref(d.id), label: d.data.label ?? d.data.title };
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: link(docs[i - 1]), next: link(docs[i + 1]) },
  }));
}

interface Props {
  entry: DocEntry;
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---
<Docs
  path={docHref(entry.id)}
  section={sectionTitle(entry.id)}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  prev={prev}
  next={next}
  source={entry.filePath && !entry.body?.includes("<!-- Generated by") ? `apps/website/${entry.filePath}` : undefined}
>
  <Content />
</Docs>
