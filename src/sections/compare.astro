---
import SectionHead from "@/components/section-head.astro";
import { Alternatives } from "@/components/alternatives";
---
<section id="compare" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="compared to the alternatives"
      title="Not a starter kit.<br />Not an agent platform."
      lede="Pick the plan you'd otherwise follow."
    />
    <div class="mt-8">
      <Alternatives client:visible />
    </div>
  </div>
</section>
