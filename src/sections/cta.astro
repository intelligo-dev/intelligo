---
import { SITE } from "@/lib/site";
---
<section id="end" class="xline">
  <div class="reveal flex flex-col items-center px-6 py-16 text-center md:py-20">
    <h2 class="heading text-[clamp(1.7rem,3.2vw,2.4rem)] font-bold leading-tight text-muted-foreground">
      Point your agent at the <span class="text-foreground">30%</span>.
    </h2>
    <p class="mt-3 max-w-[48ch] text-[0.98rem] text-muted-foreground">Everything else is already here.</p>
    <div class="mt-6 flex items-center gap-2">
      <a href={SITE.github} class="btn btn-outline">GitHub</a>
      <a href="#quickstart" class="btn btn-primary">Get started</a>
    </div>
  </div>
</section>
