---
import Page from "@/layouts/Page.astro";
import { SITE } from "@/lib/site";
---
<Page
  path="/404"
  tag="404"
  title="Nothing at this route."
  lede="The page moved, or never existed. The registry items live under /r, everything else is one of the links below."
  description="Page not found — intelligo.dev"
>
  <section class="xline">
    <div class="grid gap-px border-b border-border bg-border px-0 sm:grid-cols-2 lg:grid-cols-4">
      {[
        [SITE.docs, "Docs", "getting started, concepts, packages"],
        ["/blocks", "Blocks", "every registry item, rendered"],
        ["/components", "Components", "the design system, live"],
        ["/architecture", "Architecture", "packages, rules, ownership"],
      ].map(([href, h, b]) => (
        <a href={href} class="bg-background px-6 py-6 no-underline transition-colors hover:bg-accent md:px-10">
          <span class="block text-[1rem] font-semibold text-foreground">{h} →</span>
          <span class="mt-1 block text-[0.86rem] text-foreground/70">{b}</span>
        </a>
      ))}
    </div>
  </section>
</Page>
