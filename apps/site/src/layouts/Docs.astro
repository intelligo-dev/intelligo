---
/**
 * A docs page: the site's nav and rails, a section sidebar, the article,
 * an on-page contents list on wide screens, and prev/next in reading
 * order. Shares the token contract with every other page, so the theme
 * toggle and the design system reach the docs unchanged.
 */
import Base from "@/layouts/Base.astro";
import Footer from "@/components/footer.astro";
import { Nav } from "@/components/nav";
import { SITE } from "@/lib/site";
import { docsSidebar } from "@/lib/docs-nav";
import type { MarkdownHeading } from "astro";

interface Props {
  path: string;
  section: string;
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
  /** Repository path of the source file, for the edit link. */
  source?: string;
}
const { path, section, title, description, headings = [], prev, next, source } = Astro.props;
const sidebar = await docsSidebar();
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={`${title} — ${SITE.name} docs`} description={description}>
  <Nav client:load current={path} />
  <main class="rails">
    <div class="grid grid-cols-1 border-t border-border lg:grid-cols-[230px_minmax(0,1fr)] xl:grid-cols-[230px_minmax(0,1fr)_200px]">
      <aside class="hidden border-r border-border lg:block">
        <nav aria-label="Docs" class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto px-6 py-8">
          {sidebar.map((s) => (
            <div class="mb-6">
              <div class="tag mb-1.5">{s.title}</div>
              <ul class="space-y-0.5">
                {s.items.map((i) => (
                  <li>
                    <a
                      href={i.href}
                      aria-current={i.href === path ? "page" : undefined}
                      class:list={[
                        "-mx-2 block rounded-md px-2 py-1 text-[0.86rem] no-underline transition-colors",
                        i.href === path ? "bg-muted font-medium text-foreground" : "text-foreground/70 hover:text-foreground",
                      ]}
                    >{i.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <div class="min-w-0">
        <details class="border-b border-border lg:hidden">
          <summary class="mono cursor-pointer px-6 py-3 text-[0.8rem] text-foreground/70">{section} · docs menu</summary>
          <nav aria-label="Docs" class="px-6 pb-4">
            {sidebar.map((s) => (
              <div class="mt-3">
                <div class="tag mb-1">{s.title}</div>
                <ul class="space-y-0.5">
                  {s.items.map((i) => (
                    <li><a href={i.href} class:list={["block py-1 text-[0.9rem] no-underline", i.href === path ? "text-foreground" : "text-foreground/70"]}>{i.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </details>

        <article class="px-6 py-10 md:px-10 md:py-14">
          <header class="mb-8 border-b border-border pb-8">
            <span class="tag">{section}</span>
            <h1 class="heading mt-2 text-[clamp(1.8rem,3vw,2.5rem)] font-medium leading-[1.08]">{title}</h1>
            <p class="mt-3 max-w-[62ch] text-[1.02rem] text-muted-foreground">{description}</p>
          </header>
          <div class="docs-prose">
            <slot />
          </div>

          <nav aria-label="Previous and next" class="mt-14 grid grid-cols-2 gap-3 border-t border-border pt-6">
            {prev ? (
              <a href={prev.href} class="rounded-md border border-border px-4 py-3 no-underline hover:bg-card">
                <span class="mono block text-[0.68rem] text-muted-foreground">← previous</span>
                <span class="block text-[0.92rem] text-foreground">{prev.label}</span>
              </a>
            ) : <span />}
            {next && (
              <a href={next.href} class="col-start-2 rounded-md border border-border px-4 py-3 text-right no-underline hover:bg-card">
                <span class="mono block text-[0.68rem] text-muted-foreground">next →</span>
                <span class="block text-[0.92rem] text-foreground">{next.label}</span>
              </a>
            )}
          </nav>
          {source && (
            <p class="mono mt-6 text-[0.7rem] text-muted-foreground">
              <a href={`${SITE.github}/edit/main/${source}`} class="hover:text-foreground">Edit this page on GitHub →</a>
            </p>
          )}
        </article>
      </div>

      <aside class="hidden border-l border-border xl:block">
        {toc.length > 1 && (
          <nav aria-label="On this page" class="sticky top-14 px-5 py-10">
            <div class="tag mb-2">On this page</div>
            <ul class="space-y-1">
              {toc.map((h) => (
                <li class:list={[h.depth === 3 && "pl-3"]}>
                  <a href={`#${h.slug}`} class="block text-[0.8rem] leading-snug text-foreground/70 no-underline hover:text-foreground">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </aside>
    </div>
    <Footer />
  </main>
</Base>
