{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "INTELLIGO_DB_DRIVER",
    "AUTH_SECRET",
    "BETTER_AUTH_SECRET",
    "CRON_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PUBLISHABLE_KEY",
    "RESEND_API_KEY",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "VERCEL_URL",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "app/**",
        "components/**",
        "lib/**",
        "tools/**",
        "actions/**",
        "templates/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json",
        "next.config.*",
        "public/**",
        "astro.config.*",
        "wrangler.jsonc",
        "hooks/**",
        "i18n/**",
        "messages/**",
        "proxy.ts",
        "middleware.ts",
        "instrumentation.ts",
        "drizzle/**",
        "postcss.config.*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "src/**",
        "app/**",
        "components/**",
        "lib/**",
        "tools/**",
        "actions/**",
        "*.config.*",
        "hooks/**",
        "i18n/**",
        "proxy.ts",
        "instrumentation.ts"
      ]
    },
    "type-check": {
      "inputs": [
        "src/**",
        "app/**",
        "components/**",
        "lib/**",
        "tools/**",
        "actions/**",
        "tsconfig.json",
        "astro.config.*",
        "hooks/**",
        "i18n/**",
        "proxy.ts",
        "middleware.ts",
        "instrumentation.ts"
      ],
      "dependsOn": ["^type-check"]
    },
    "@intelligo-dev/registry#build": {
      "dependsOn": [],
      "inputs": ["registry.json", "base/**"],
      "outputs": ["public/r/**"]
    },
    "@intelligo-dev/registry#lint": {
      "inputs": ["registry.json", "base/**"]
    },
    "sync": {
      "cache": false,
      "dependsOn": ["@intelligo-dev/registry#build"]
    },
    "@intelligo-dev/registry#type-check": {
      "dependsOn": ["^type-check"],
      "inputs": [
        "registry.json",
        "requires.json",
        "base/**",
        "tsconfig.json",
        "scripts/**",
        "$TURBO_ROOT$/apps/app/components/ui/**",
        "$TURBO_ROOT$/apps/app/lib/**",
        "$TURBO_ROOT$/apps/app/hooks/**",
        "$TURBO_ROOT$/apps/app/i18n/**"
      ]
    },
    "@intelligo-dev/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/registry/requires.json",
        "$TURBO_ROOT$/packages/registry/registry.json"
      ],
      "outputs": ["dist/**"]
    },
    "film#build": {
      "dependsOn": [],
      "inputs": ["src/**", "public/**", "package.json", "remotion.config.ts"],
      "outputs": ["build/**"]
    }
  }
}
