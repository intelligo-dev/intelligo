{
  "name": "@intelligo-dev/core",
  "version": "1.0.0-beta.9",
  "description": "Database schema, email, logging, notifications, and the conversation, document and identity contracts.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "drizzle",
    "postgres",
    "pgvector",
    "conversations",
    "documents"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-dev/intelligo.git",
    "directory": "packages/core"
  },
  "homepage": "https://intelligo.dev/docs/packages/core",
  "bugs": {
    "url": "https://github.com/intelligo-dev/intelligo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./email": "./src/email/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./conversations": "./src/conversations/index.ts",
    "./documents": "./src/documents/index.ts",
    "./identity": "./src/identity/index.ts",
    "./attachments": "./src/attachments/index.ts",
    "./storage": "./src/storage/index.ts",
    "./env": "./src/env.ts",
    "./registry": "./src/registry.ts",
    "./money": "./src/money.ts",
    "./request-context": "./src/request-context.ts",
    "./prompt": "./src/prompt.ts",
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./src/logger.ts",
      "default": "./src/logger.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "tsx scripts/check-db.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "dotenv": "^17.4.2",
    "pg": "8.18.0",
    "pino": "^10.3.1",
    "resend": "^6.28.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "next": "~16.3.5",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./db": {
        "types": "./dist/db/index.d.ts",
        "default": "./dist/db/index.js"
      },
      "./db/schema": {
        "types": "./dist/db/schema/index.d.ts",
        "default": "./dist/db/schema/index.js"
      },
      "./email": {
        "types": "./dist/email/index.d.ts",
        "default": "./dist/email/index.js"
      },
      "./notifications": {
        "types": "./dist/notifications/index.d.ts",
        "default": "./dist/notifications/index.js"
      },
      "./conversations": {
        "types": "./dist/conversations/index.d.ts",
        "default": "./dist/conversations/index.js"
      },
      "./documents": {
        "types": "./dist/documents/index.d.ts",
        "default": "./dist/documents/index.js"
      },
      "./identity": {
        "types": "./dist/identity/index.d.ts",
        "default": "./dist/identity/index.js"
      },
      "./attachments": {
        "types": "./dist/attachments/index.d.ts",
        "default": "./dist/attachments/index.js"
      },
      "./storage": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.js"
      },
      "./env": {
        "types": "./dist/env.d.ts",
        "default": "./dist/env.js"
      },
      "./registry": {
        "types": "./dist/registry.d.ts",
        "default": "./dist/registry.js"
      },
      "./money": {
        "types": "./dist/money.d.ts",
        "default": "./dist/money.js"
      },
      "./request-context": {
        "types": "./dist/request-context.d.ts",
        "default": "./dist/request-context.js"
      },
      "./prompt": {
        "types": "./dist/prompt.d.ts",
        "default": "./dist/prompt.js"
      },
      "./logger": {
        "types": "./dist/logger.d.ts",
        "import": "./dist/logger.js",
        "default": "./dist/logger.js"
      }
    }
  },
  "engines": {
    "node": ">=22.14"
  },
  "sideEffects": false
}
