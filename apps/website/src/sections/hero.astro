---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
/**
 * The title card. One headline, one command, a cue to scroll — the
 * product appears in scene 01, not here.
 */
import { HeroTitle } from "@/components/hero-title";
import { InstallCommand } from "@/components/install-command";
import { SITE } from "@/lib/site";

const create = "pnpm dlx @intelligo-dev/cli@beta create my-app";
---
<header id="top" class="relative overflow-hidden">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-[calc(100dvh-3.5rem)] max-w-[880px] flex-col items-center justify-center px-6 pb-24 pt-16 text-center">
    <HeroTitle />

    <p class="mx-auto mt-6 max-w-[56ch] text-[1.08rem] leading-relaxed text-foreground/70">
      A Next.js framework for AI SaaS: sign-up, teams, plans, credits, usage and an admin console — a complete SaaS around your agent. The pages land in your repo as your code. The engine under them is npm packages you upgrade.{" "}
      <span class="text-foreground">Open source, nothing rented.</span>
    </p>

    <div class="mt-8 flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:gap-2">
      <a href={SITE.start} class={cn(buttonVariants({ size: "lg" }), "w-full sm:w-auto")}>Get started</a>
      <a href="#film" class={cn(buttonVariants({ variant: "outline", size: "lg" }), "w-full border-foreground/20 bg-background/80 sm:w-auto")}>
        See it running <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div class="mt-4 w-full max-w-[460px]">
      <InstallCommand client:visible cmd={create} className="justify-center bg-background/80 backdrop-blur" />
    </div>

    <p class="mono mt-4 text-[0.72rem] text-muted-foreground">
      <span class="sr-only">Built on </span>Next.js 16 · PostgreSQL · Drizzle · Better-Auth · Stripe · Vercel AI SDK
    </p>

    <a href="#film" class="scroll-cue mono absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 text-[0.68rem] uppercase tracking-[0.12em] text-muted-foreground no-underline hover:text-foreground" aria-label="Scroll to the film">
      <span>watch it build</span>
      <span aria-hidden="true">↓</span>
    </a>
  </div>
</header>
