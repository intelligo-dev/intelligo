{
  "name": "intelligo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "registry:build": "shadcn build ./registry.json --output ./public/r --cwd ./registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "db:push": "pnpm --filter @intelligo-dev/core db:push",
    "db:generate": "pnpm --filter @intelligo-dev/core db:generate",
    "db:migrate": "pnpm --filter @intelligo-dev/core db:migrate",
    "db:studio": "pnpm --filter @intelligo-dev/core db:studio",
    "db:check": "pnpm --filter @intelligo-dev/core db:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.22.1",
    "@typescript-eslint/parser": "^8.22.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pg": "^8.18.0",
    "prettier": "^3.4.2",
    "shadcn": "^3.8.4",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "pg": "8.18.0",
      "next": "~16.2.11",
      "next-intl": ">=4.9.1",
      "drizzle-orm": ">=0.45.2",
      "eslint-config-next": "~16.2.11",
      "next-mdx-remote": ">=6.0.0",
      "axios": ">=1.15.0",
      "nodemailer": ">=8.0.5",
      "@hono/node-server": ">=1.19.15",
      "hono": ">=4.12.34",
      "vite": ">=7.3.2",
      "defu": ">=6.1.5",
      "kysely": ">=0.28.14",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "serialize-javascript": ">=7.0.5",
      "yaml": ">=2.8.3",
      "brace-expansion": ">=2.0.3",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "undici": ">=6.24.0",
      "flatted": ">=3.4.2",
      "express-rate-limit": ">=8.2.2",
      "esbuild": ">=0.25.0",
      "follow-redirects": ">=1.16.0",
      "markdown-it": ">=14.1.1",
      "mailparser": ">=3.9.3",
      "qs": ">=6.14.2",
      "ajv@6": "^6.14.0",
      "nanoid": ">=3.3.18",
      "js-yaml@3": "^3.15.1",
      "ip-address": ">=10.3.1"
    }
  }
}
