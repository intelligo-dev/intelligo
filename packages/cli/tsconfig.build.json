{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // Emitted ESM needs real specifiers; the source uses extensionless
    // relative imports, so nodenext resolution would reject it. The CLI
    // is executed by Node directly, not bundled, which is why this
    // package is the one that has to get emit right.
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "node_modules", "dist"]
}
