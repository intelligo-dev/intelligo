---
import SectionHead from "@/components/section-head.astro";
import { Quickstart } from "@/components/quickstart";
import { SITE } from "@/lib/site";
---
<section id="quickstart" class="xline band">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      n="06"
      tag="quickstart"
      title="Three commands.<br />Running before you touch a model key."
      lede="Node 22, pnpm 9 and a PostgreSQL database. The chat page streams against a built-in stub model, so the whole app runs before you configure a provider."
    />
    <div class="mt-8">
      <Quickstart client:visible />
    </div>
    <div class="mt-10 flex flex-col items-center gap-4 border-t border-line pt-10 text-center">
      <h3 class="heading text-[clamp(1.6rem,3vw,2.2rem)] font-bold leading-tight text-muted-foreground">
        Point your agent at the <span class="text-foreground">30%</span>.
      </h3>
      <p class="max-w-[46ch] text-[0.95rem] text-muted-foreground">Everything else is already here — versioned on npm, installed as source you own, Apache-2.0.</p>
      <div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:gap-2">
        <a href={SITE.github} class="btn btn-primary btn-xl w-full sm:w-auto">Star on GitHub</a>
        <a href={SITE.docs} class="btn btn-outline btn-xl w-full sm:w-auto">Read the docs</a>
      </div>
      <p class="mono text-[0.72rem] text-ink-faint">Database, environment, migrations, AI providers and the other page families are in the docs.</p>
    </div>
  </div>
</section>
