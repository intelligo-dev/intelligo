---
/**
 * The registry catalog: every block in a rail, the one chosen rendered
 * live beside its install command, each linking to its own page.
 */
import Page from "@/layouts/Page.astro";
import { RegistryExplorer } from "@/components/registry-explorer";
import { REGISTRY_COUNT } from "@/lib/registry-items";
---
<Page
  path="/blocks"
  compact
  gallery="pages"
  title="Pages"
  lede={`${REGISTRY_COUNT} blocks you install as source with the shadcn CLI — pages, shells and drop-in surfaces, rendered live.`}
  description={`All ${REGISTRY_COUNT} Intelligo registry blocks, rendered live, installed as consumer-owned source with the shadcn CLI.`}
>
  <section id="explorer" class="xline">
    <div><RegistryExplorer client:load /></div>
  </section>
</Page>
