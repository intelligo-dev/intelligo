{
  "name": "@intelligo-dev/next",
  "version": "1.0.0-beta.9",
  "description": "The Next.js adapter: the one Intelligo package that imports next/*, binding request context and auth routes.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "nextjs",
    "adapter",
    "better-auth"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-dev/intelligo.git",
    "directory": "packages/next"
  },
  "homepage": "https://intelligo.dev/docs/packages/next",
  "bugs": {
    "url": "https://github.com/intelligo-dev/intelligo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/auth": "workspace:*",
    "@intelligo-dev/core": "workspace:*",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "better-auth": "~1.6.30",
    "next": "^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "better-auth": "~1.6.33",
    "next": "~16.3.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./auth": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      }
    }
  },
  "engines": {
    "node": ">=22.14"
  }
}
