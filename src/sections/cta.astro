---
import { SITE } from "@/lib/site";
---
<section id="end" class="xline">
  <div class="reveal flex flex-col items-center px-6 py-16 text-center md:py-20">
    <h2 class="heading text-[clamp(1.7rem,3.2vw,2.4rem)] font-bold leading-tight text-muted-foreground">
      Point your agent at the <span class="text-foreground">30%</span>.
    </h2>
    <p class="mt-3 max-w-[48ch] text-[0.98rem] text-muted-foreground">Everything else is already here, tested, and yours to change.</p>
    <div class="mt-6 flex items-center gap-2">
      <a href={SITE.adrs} class="btn btn-outline">Read the decisions</a>
      <a href={SITE.github} class="btn btn-primary">Star on GitHub</a>
    </div>
  </div>
</section>

<footer class="xline">
  <div class="flex flex-wrap items-start justify-between gap-8 px-6 py-10 md:px-10">
    <div>
      <span class="heading flex items-center gap-2 text-[1.05rem] font-semibold tracking-tight">
        <span class="inline-block size-3 rounded-[3px] bg-foreground" aria-hidden="true"></span>{SITE.name}
      </span>
      <p class="mt-3 text-[0.85rem] text-muted-foreground">You build the agent. Everything around it is here.</p>
      <p class="mt-6 text-[0.75rem] text-muted-foreground">Apache-2.0 · pre-release</p>
    </div>
    <div class="grid grid-cols-2 gap-x-14 gap-y-2 text-[0.85rem]">
      <div class="flex flex-col gap-2">
        <span class="font-medium text-foreground">Project</span>
        <a href={SITE.github} class="text-muted-foreground no-underline hover:text-foreground">GitHub</a>
        <a href={SITE.adrs} class="text-muted-foreground no-underline hover:text-foreground">Decisions</a>
        <a href={SITE.license} class="text-muted-foreground no-underline hover:text-foreground">License</a>
      </div>
      <div class="flex flex-col gap-2">
        <span class="font-medium text-foreground">On this page</span>
        <a href="#boundary" class="text-muted-foreground no-underline hover:text-foreground">The boundary</a>
        <a href="#pages" class="text-muted-foreground no-underline hover:text-foreground">Pages</a>
        <a href="#quickstart" class="text-muted-foreground no-underline hover:text-foreground">Quickstart</a>
      </div>
    </div>
  </div>
</footer>
