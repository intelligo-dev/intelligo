---
import { InstallCommand } from "@/components/install-command";
import { SITE } from "@/lib/site";

const create = "pnpm dlx @intelligo-dev/cli@beta create my-app";
---
<section id="end" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <div class="card top-shade reveal relative overflow-hidden px-6 py-14 text-center md:py-20">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-[640px] flex-col items-center">
        <h2 class="heading text-[clamp(1.9rem,3.6vw,2.8rem)] font-bold leading-[1.05] text-muted-foreground">
          Point your agent at the <span class="text-foreground">30%</span>.
        </h2>
        <p class="mt-4 max-w-[46ch] text-[1rem] text-muted-foreground">Everything else is already here — versioned on npm, installed as source you own, Apache-2.0.</p>
        <div class="mt-7 flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:gap-2">
          <a href="#quickstart" class="btn btn-primary btn-xl w-full sm:w-auto">Get started</a>
          <a href={SITE.github} class="btn btn-outline btn-xl w-full sm:w-auto">Star on GitHub</a>
        </div>
        <div class="mt-4 w-full max-w-[460px]">
          <InstallCommand client:visible cmd={create} className="justify-center" />
        </div>
      </div>
    </div>
  </div>
</section>
