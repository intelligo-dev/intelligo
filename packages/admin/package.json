{
  "name": "@intelligo-dev/admin",
  "version": "1.0.0-beta.8",
  "description": "The operational console: cross-tenant queries, health probes and impersonation.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "admin",
    "operations",
    "impersonation",
    "multi-tenant"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-mn/framework.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/intelligo-mn/framework#readme",
  "bugs": {
    "url": "https://github.com/intelligo-mn/framework/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./views": "./src/views/index.ts",
    "./health": "./src/health.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/audit": "workspace:*",
    "@intelligo-dev/auth": "workspace:*",
    "@intelligo-dev/core": "workspace:*",
    "@intelligo-dev/executions": "workspace:*",
    "@intelligo-dev/jobs": "workspace:*",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "19.2.18",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./views": {
        "types": "./dist/views/index.d.ts",
        "default": "./dist/views/index.js"
      },
      "./health": {
        "types": "./dist/health.d.ts",
        "default": "./dist/health.js"
      }
    }
  },
  "engines": {
    "node": ">=22.14"
  }
}
