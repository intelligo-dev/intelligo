# ============================================
# REQUIRED ENVIRONMENT VARIABLES
# The reference app cannot function without these.
# ============================================

# Database (Required) — Postgres with the pgvector extension.
# `docker compose up -d` starts one on port 5445 with this URL; any
# other Postgres (Neon, Supabase, RDS) works too.
DATABASE_URL=postgres://postgres:postgres@localhost:5445/intelligo

# Authentication (Required) — at least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Application URL (Required)
# Development: http://localhost:4002 (apps/app)
NEXT_PUBLIC_APP_URL=http://localhost:4002

# ============================================
# OPTIONAL: AI providers
# The reference app streams against a built-in stub model, so nothing
# here is needed to run it. Your own product wires the provider it uses.
# ============================================

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ============================================
# OPTIONAL: OAuth Providers
# Social login buttons are hidden when not configured
# ============================================

# Google OAuth — https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ============================================
# OPTIONAL: Email
# Emails are logged to the console if no provider is configured
# ============================================

# Options: resend, loops, console. Auto-detected from the keys below
# when unset.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=noreply@example.com

# Resend — https://resend.com/api-keys
# RESEND_API_KEY=

# Loops — https://loops.so/settings/api
# Loops sends by transactional template id (no raw HTML) — create each
# email in the Loops dashboard and map framework template keys to its
# ids below. Keys: welcome, verify-email, password-reset,
# workspace-invitation, quota-warning, quota-exceeded, trial-warning,
# trial-depleted, payment-failed, subscription-confirmed, trial-expiry
# LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_ID_WELCOME=
# LOOPS_TRANSACTIONAL_ID_VERIFY_EMAIL=
# LOOPS_TRANSACTIONAL_ID_PASSWORD_RESET=
# LOOPS_TRANSACTIONAL_ID_WORKSPACE_INVITATION=
# LOOPS_TRANSACTIONAL_ID_QUOTA_WARNING=
# LOOPS_TRANSACTIONAL_ID_QUOTA_EXCEEDED=
# LOOPS_TRANSACTIONAL_ID_TRIAL_WARNING=
# LOOPS_TRANSACTIONAL_ID_TRIAL_DEPLETED=
# LOOPS_TRANSACTIONAL_ID_PAYMENT_FAILED=
# LOOPS_TRANSACTIONAL_ID_SUBSCRIPTION_CONFIRMED=
# LOOPS_TRANSACTIONAL_ID_TRIAL_EXPIRY=

# ============================================
# OPTIONAL: Billing (Stripe)
# Billing surfaces show "not configured" when missing
# ============================================

# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================
# OPTIONAL: Platform
# ============================================

# Comma-separated emails promoted to platform admin on first sign-in
# PLATFORM_ADMIN_EMAILS=

# Authenticates scheduled (cron) requests. Generate with: openssl rand -base64 32
# CRON_SECRET=

# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV=development
