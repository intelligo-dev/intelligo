---
import { FOOTER, SITE } from "@/lib/site";
---
<footer class="xline">
  <div class="flex flex-wrap items-start justify-between gap-8 px-6 py-10 md:px-10">
    <div>
      <span class="heading flex items-center gap-2 text-[1.05rem] font-semibold tracking-tight">
        <span class="inline-block size-3 rounded-[3px] bg-foreground" aria-hidden="true"></span>{SITE.name}
      </span>
      <p class="mt-3 text-[0.85rem] text-muted-foreground">You build the agent. Intelligo is everything around it.</p>
      <p class="mt-6 text-[0.75rem] text-muted-foreground">Apache-2.0 · {SITE.status}</p>
    </div>
    <div class="grid grid-cols-2 gap-x-14 gap-y-6 text-[0.85rem] sm:grid-cols-4">
      {FOOTER.map((col) => (
        <div class="flex flex-col gap-2">
          <span class="font-medium text-foreground">{col.title}</span>
          {col.links.map((l) => (
            <a href={l.href} class="text-muted-foreground no-underline hover:text-foreground">{l.label}</a>
          ))}
        </div>
      ))}
    </div>
  </div>
</footer>
