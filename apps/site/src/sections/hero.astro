---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
/**
 * The title card. One headline, one command, a cue to scroll — the
 * product appears in scene 01, not here.
 */
import { HeroTitle } from "@/components/hero-title";
import { InstallCommand } from "@/components/install-command";
import { SITE } from "@/lib/site";

const create = "pnpm dlx @intelligo-dev/cli@beta create my-app";
---
<header id="top" class="relative overflow-hidden">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-[calc(100vh-3.5rem)] max-w-[880px] flex-col items-center justify-center px-6 py-16 text-center">
    <a href={SITE.npm} class="mb-7 inline-flex h-7 items-center overflow-hidden rounded-full border border-border bg-background/80 text-[0.78rem] no-underline backdrop-blur">
      <span class="flex items-center gap-2 whitespace-nowrap px-3 font-medium text-foreground">
        <span class="pulse" aria-hidden="true"></span>v{SITE.version} on npm
      </span>
      <span class="h-full w-px bg-border" aria-hidden="true"></span>
      <span class="whitespace-nowrap px-3 text-muted-foreground transition-colors hover:text-foreground">Apache-2.0 <span class="hidden sm:inline">· open source</span> ↗</span>
    </a>

    <HeroTitle client:load />

    <p class="mx-auto mt-6 max-w-[54ch] text-[1.08rem] leading-relaxed text-foreground/70">
      The application framework for vertical AI SaaS. Auth, workspaces, billing, credits, execution accounting, pages and operations — versioned packages and source you own.
      <span class="text-foreground">Your AI framework stays native.</span>
    </p>

    <div class="mt-8 flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:gap-2">
      <a href="#quickstart" class={cn(buttonVariants({ size: "lg" }), "w-full sm:w-auto")}>Get started</a>
      <a href={SITE.github} class={cn(buttonVariants({ variant: "outline", size: "lg" }), "w-full sm:w-auto")}>
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        GitHub
      </a>
    </div>

    <div class="mt-4 w-full max-w-[460px]">
      <InstallCommand client:visible cmd={create} className="justify-center bg-background/80 backdrop-blur" />
    </div>

    <a href="#film" class="scroll-cue mono absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 text-[0.68rem] uppercase tracking-[0.12em] text-muted-foreground no-underline hover:text-foreground" aria-label="Scroll to the film">
      <span>watch it build</span>
      <span aria-hidden="true">↓</span>
    </a>
  </div>
</header>
