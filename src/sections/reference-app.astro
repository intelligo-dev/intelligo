---
import SectionHead from "@/components/section-head.astro";
import { ProductWalkthrough } from "@/components/product-walkthrough";
import { SITE } from "@/lib/site";
---
<section id="reference-app" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="the reference app"
      title="One application.<br />Every screen wired to a package."
      lede="apps/app is assembled from the same public packages and registry items you install — nothing private, nothing hand-patched. CI rebuilds it from a clean scaffold on every run."
    />
    <div class="mt-8 card top-shade p-4 md:p-6">
      <ProductWalkthrough client:load />
    </div>
    <p class="mono mt-4 text-[0.72rem] text-ink-faint">
      <a href={`${SITE.github}/tree/main/apps/app`} class="hover:text-ink">apps/app on GitHub →</a>
    </p>
  </div>
</section>
