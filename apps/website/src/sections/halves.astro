---
/**
 * After the film: the two halves of an AI product, named. The right side
 * is one line per package; /product walks every service behind them
 * (lib/ledger.ts).
 */
import SectionHead from "@/components/section-head.astro";
import { OTHER_HALF, OTHER_HALF_SUMMARY, YOUR_HALF } from "@/lib/ledger";
---
<section id="halves" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="how it divides"
      title="Every AI product is two halves.<br />You should only write one."
      lede="The interesting half is your agent. The other half — who is signed in, what their plan allows, what a run cost, who to bill, what to tell an auditor — is the same in every AI SaaS, and it is where the time goes."
    />
    <div class="reveal mt-10 grid gap-px overflow-hidden rounded-xl border border-border bg-border lg:grid-cols-[1fr_2fr]">
      <div class="bg-card p-6 top-shade">
        <div class="tag">yours · in your AI framework</div>
        <ul class="mt-4 space-y-3">
          {YOUR_HALF.map((h) => (
            <li>
              <span class="block text-[1.05rem] font-semibold text-foreground">{h.title}</span>
              <span class="block text-[0.85rem] text-foreground/70">{h.note}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-background p-6">
        <div class="tag">intelligo · {OTHER_HALF.length} services and surfaces, shipped</div>
        <ul class="mt-4 space-y-2.5">
          {OTHER_HALF_SUMMARY.map((l) => (
            <li class="grid gap-x-4 sm:grid-cols-[7rem_1fr]">
              <span class="mono text-[0.72rem] leading-6 text-muted-foreground">{l.pkg}</span>
              <span class="text-[0.9rem] leading-snug text-foreground/80">{l.text}</span>
            </li>
          ))}
        </ul>
        <div class="mono mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[0.75rem] text-muted-foreground">
          <a href="/product" class="hover:text-foreground">all {OTHER_HALF.length}, job by job →</a>
          <a href="/architecture" class="hover:text-foreground">how the packages fit →</a>
          <a href="/why#agents" class="hover:text-foreground">why a good coding agent still gets this half wrong →</a>
        </div>
      </div>
    </div>
  </div>
</section>
