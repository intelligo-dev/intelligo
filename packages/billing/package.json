{
  "name": "@intelligo-dev/billing",
  "version": "1.0.0-beta.8",
  "description": "Quota engine, credits, Stripe, feature gates, trials and rate limiting.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "billing",
    "stripe",
    "credits",
    "quotas",
    "entitlements",
    "rate-limiting"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-mn/framework.git",
    "directory": "packages/billing"
  },
  "homepage": "https://github.com/intelligo-mn/framework#readme",
  "bugs": {
    "url": "https://github.com/intelligo-mn/framework/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plans": "./src/plans.ts",
    "./payment": "./src/payment.ts",
    "./plan-registry": "./src/plan-registry.ts",
    "./quota-types": "./src/quota-types.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./quota": "./src/quota.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "db:seed-plans": "tsx src/seed-plans.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/core": "workspace:*",
    "@intelligo-dev/executions": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "stripe": ">=20.3.1 <23",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "~16.3.5",
    "stripe": "^22.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./plans": {
        "types": "./dist/plans.d.ts",
        "default": "./dist/plans.js"
      },
      "./payment": {
        "types": "./dist/payment.d.ts",
        "default": "./dist/payment.js"
      },
      "./plan-registry": {
        "types": "./dist/plan-registry.d.ts",
        "default": "./dist/plan-registry.js"
      },
      "./quota-types": {
        "types": "./dist/quota-types.d.ts",
        "default": "./dist/quota-types.js"
      },
      "./rate-limit": {
        "types": "./dist/rate-limit.d.ts",
        "default": "./dist/rate-limit.js"
      },
      "./quota": {
        "types": "./dist/quota.d.ts",
        "default": "./dist/quota.js"
      }
    }
  },
  "engines": {
    "node": ">=22.14"
  },
  "sideEffects": false
}
