---
/**
 * The design system, in the order a reader cares about it:
 * Intelligo's own AI parts and patterns first, then the shadcn tiers
 * they sit on, then the token contract underneath. One sidebar across
 * all of it; every demo is the installed source, live.
 */
import Page from "@/layouts/Page.astro";
import { PrimitiveDemo } from "@/showcase/primitives";
import { IntelligoDemo } from "@/showcase/intelligo-demos";
import { CATALOG, INTELLIGO, INTELLIGO_GROUPS, TIERS, type ComponentName } from "@/lib/primitives";
import { blockHref } from "@/lib/registry-items";
import { CONTRAST_PAIRS, DURATIONS, EASINGS, LAYERS, TOKENS } from "@/lib/design-tokens";
import { countWord } from "@/lib/count-words";
import { SITE } from "@/lib/site";

const COLORS: [string, string[]][] = [
  ["Surface", ["background", "foreground", "card", "card-foreground", "popover", "popover-foreground"]],
  ["Intent", ["primary", "primary-foreground", "secondary", "secondary-foreground", "muted", "muted-foreground", "accent", "accent-foreground"]],
  ["Edge", ["border", "input", "ring"]],
  ["Chart", ["chart-1", "chart-2", "chart-3", "chart-4", "chart-5"]],
  ["Sidebar", ["sidebar", "sidebar-foreground", "sidebar-primary", "sidebar-primary-foreground", "sidebar-accent", "sidebar-accent-foreground", "sidebar-border", "sidebar-ring"]],
];
const STATUS = ["destructive", "success", "warning", "info"];
const RADII = ["sm", "md", "lg", "xl", "2xl"];
const FONTS = [
  ["--font-sans", "Geist", "font-sans", "Workspaces, credits and every page around your agent."],
  ["--font-mono", "Geist Mono", "font-mono", "pnpm exec shadcn add intelligo.dev/r/chat.json"],
  ["--font-heading", "Outfit · site only", "heading", "The application framework for vertical AI SaaS."],
];
const idOf = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const Count = countWord(INTELLIGO.length);

type Entry = { name: string; label: string; description: string; usedBy: string[]; intelligo: boolean };

/** What a reader calls it: "AI Message Bubble" → "Message bubble", "alert-dialog" → "Alert dialog". */
const readable = (s: string) => {
  const words = s.replace(/^AI\s+/, "").replace(/-/g, " ").trim();
  return words.charAt(0).toUpperCase() + words.slice(1).toLowerCase();
};
type Group = { id: string; tag: string; title: string; lede?: string; entries: Entry[] };

const GROUPS: Group[] = [
  ...INTELLIGO_GROUPS.map((g) => {
    const entries = INTELLIGO.filter((e) => e.group === g);
    const tier = entries[0]!.tier;
    return {
      id: idOf(g),
      tag: `${tier} · ${TIERS[tier].title}`,
      title: g,
      lede: g === "Patterns" ? TIERS.T4.lede : undefined,
      entries: entries.map((e) => ({ ...e, label: readable(e.title), intelligo: true })),
    };
  }),
  ...(["T1", "T2"] as const).map((tier) => ({
    id: tier.toLowerCase(),
    tag: `${tier} · shadcn base-nova`,
    title: TIERS[tier].title,
    lede: TIERS[tier].lede,
    entries: CATALOG.filter((c) => c.tier === tier).map((c) => ({ ...c, label: readable(c.name), intelligo: false })),
  })),
];

const install = (e: Entry) =>
  e.intelligo ? `pnpm dlx shadcn add ${SITE.registryBase}/${e.name}.json` : `pnpm dlx shadcn add ${e.name}`;
---
<Page
  path="/components"
  tag="components · the design system"
  title={`${Count} AI parts and patterns,<br />one design system.`}
  lede={`Intelligo's own components — messages, reasoning, tool calls, approvals, citations, artifacts — on shadcn base-nova, Base UI and the intelligo token contract, beside the ${CATALOG.length} shadcn components every block also uses. Everything below is the installed source, live; switch the theme in the nav and it follows.`}
  description={`The Intelligo design system: ${INTELLIGO.length} AI parts and patterns, ${CATALOG.length} base-nova components, the token contract and WCAG AA contrast — all rendered live.`}
>
  <section class="xline">
    <div class="grid lg:grid-cols-[248px_minmax(0,1fr)]">
      <aside class="hidden border-r border-border lg:block">
        <nav aria-label="Components" class="docs-scroll sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto px-5 pb-10 pt-8" data-components-nav>
          {GROUPS.map((g) => (
            <div class="mb-7">
              <a href={`#${g.id}`} class="docs-section-title block no-underline hover:text-foreground">{g.title}</a>
              <ul class="docs-rail">
                {g.entries.map((e) => (
                  <li><a href={`#${e.name}`} data-spy={e.name} data-label={e.label} class="docs-link truncate">{e.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="docs-section-title">Foundation</div>
          <ul class="docs-rail">
            <li><a href="#tokens" data-spy="tokens" data-label="Tokens" class="docs-link">Tokens</a></li>
          </ul>
        </nav>
      </aside>

      <div class="min-w-0">
        <details class="docs-mobile-menu group sticky top-14 z-20 border-b border-border bg-background/90 backdrop-blur-md lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-6 py-3">
            <span class="flex min-w-0 items-center gap-2 text-[0.85rem]">
              <span class="text-muted-foreground">Components</span>
              <span class="text-muted-foreground" aria-hidden="true">/</span>
              <span class="truncate font-medium text-foreground" data-spy-label>{GROUPS[0]!.entries[0]!.label}</span>
            </span>
            <span class="mono flex shrink-0 items-center gap-1.5 text-[0.72rem] text-muted-foreground">
              Menu
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-normal group-open:rotate-180"><path d="m6 9 6 6 6-6" /></svg>
            </span>
          </summary>
          <nav aria-label="Components" class="docs-scroll max-h-[70vh] overflow-y-auto border-t border-border px-6 pb-6 pt-4">
            {GROUPS.map((g) => (
              <div class="mb-5">
                <div class="docs-section-title">{g.title}</div>
                <ul class="docs-rail">
                  {g.entries.map((e) => (
                    <li><a href={`#${e.name}`} data-spy={e.name} data-label={e.label} class="docs-link">{e.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="docs-section-title">Foundation</div>
            <ul class="docs-rail">
              <li><a href="#tokens" data-spy="tokens" data-label="Tokens" class="docs-link">Tokens</a></li>
            </ul>
          </nav>
        </details>

        {GROUPS.map((g, i) => (
          <section id={g.id} class:list={["scroll-mt-16 px-6 py-10 md:px-10 md:py-14", i > 0 && "border-t border-border"]}>
            <div class="section-head">
              <span class="tag">{g.tag}</span>
              <h2 class="heading text-2xl font-medium">{g.title}</h2>
              {g.lede && <p class="mt-1 text-sm text-muted-foreground">{g.lede}</p>}
            </div>
            <div class="mt-10 space-y-14">
              {g.entries.map((e) => (
                <article id={e.name} class="scroll-mt-20">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3 class="heading text-[1.3rem] font-medium">{e.label}</h3>
                    <span class="mono text-xs text-muted-foreground">
                      {e.name} · {e.usedBy.length ? `used by ${e.usedBy.length} block${e.usedBy.length === 1 ? "" : "s"}` : "not yet used by a block"}
                    </span>
                  </div>
                  <p class="mt-1 max-w-[70ch] text-sm text-foreground/70">{e.description}</p>
                  <div class="mt-4">
                    {e.intelligo ? <IntelligoDemo client:visible name={e.name} /> : <PrimitiveDemo client:visible name={e.name as ComponentName} />}
                  </div>
                  <div class="mt-3 flex flex-wrap items-center gap-1">
                    <code class="mono mr-2 max-w-full truncate rounded-md border bg-muted px-2 py-0.5 text-xs text-foreground/70">{install(e)}</code>
                    {e.usedBy.map((b) => (
                      <a href={blockHref(b)} class="mono rounded-md border px-1.5 py-0.5 text-xs text-muted-foreground no-underline hover:text-foreground">{b}</a>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}

        <section id="tokens" class="scroll-mt-16 border-t border-border px-6 py-10 md:px-10 md:py-14">
      <div class="section-head">
        <span class="tag">foundation · tokens</span>
        <h2 class="heading text-2xl font-medium">The token contract.</h2>
        <p class="mt-2 max-w-[60ch] text-sm text-muted-foreground">shadcn's official set, plus status, layer and motion tokens Intelligo adds and never renames. Read from <code class="mono">intelligo.dev/r/intelligo.json</code>.</p>
      </div>

      <div class="mt-8 space-y-6">
        {COLORS.map(([group, tokens]) => (
          <div>
            <div class="tag mb-2">{group}</div>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
              {tokens.map((t) => (
                <div class="overflow-hidden rounded-md border bg-background">
                  <div class="h-12 border-b" style={`background: var(--${t})`} />
                  <div class="mono truncate px-2 py-1.5 text-xs text-foreground/70">--{t}</div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <div>
          <div class="tag mb-2">Status · text on the page, and a fill under its foreground</div>
          <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            {STATUS.map((t) => (
              <div class="overflow-hidden rounded-md border bg-background">
                <div class="flex h-12 items-center px-3 text-sm font-medium" style={`background: var(--${t}); color: var(--${t}-foreground)`}>Aa {t}</div>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5">
                  <span class="mono truncate text-xs" style={`color: var(--${t})`}>--{t}</span>
                  <span class="mono truncate text-xs text-muted-foreground">-foreground</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <div class="tag mb-2">Radius · --radius: {TOKENS.light.radius}</div>
          <div class="flex flex-wrap gap-3">
            {RADII.map((r) => (
              <div class="text-center">
                <div class="size-16 border bg-muted" style={`border-radius: var(--radius-${r})`} />
                <div class="mono mt-1 text-xs text-muted-foreground">{r}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="min-w-0">
          <div class="tag mb-2">Type</div>
          <div class="space-y-3">
            {FONTS.map(([v, family, cls, sample]) => (
              <div class="border-b pb-3">
                <div class="mono text-xs text-muted-foreground">{v} · {family}</div>
                <div class={`${cls} mt-1 truncate text-lg`}>{sample}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="min-w-0">
          <div class="tag mb-2">Layers · z-* utilities</div>
          <div class="relative h-40">
            {LAYERS.map((layer, i) => (
              <div
                class="absolute flex h-10 w-3/5 items-center justify-between rounded-md border bg-card px-3 shadow-sm"
                style={`left: ${i * 7}%; top: ${i * 18}px; z-index: var(--${layer.name})`}
              >
                <span class="mono text-xs">{layer.name}</span>
                <span class="mono text-xs text-muted-foreground">{layer.value}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="min-w-0">
          <div class="tag mb-2">Motion · hover a row · collapsed under reduced motion</div>
          <div class="space-y-2">
            {DURATIONS.map((d) => (
              <div class="group flex items-center gap-3">
                <span class="mono w-36 shrink-0 text-xs">{d.name} · {d.value}</span>
                <div class="h-6 flex-1 rounded-md bg-muted">
                  <div class={`size-6 rounded-md bg-primary transition-transform ease-standard group-hover:translate-x-40 ${d.name}`} />
                </div>
              </div>
            ))}
            {EASINGS.map((e) => (
              <div class="mono text-xs text-muted-foreground">--{e.name}: {e.value}</div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-10">
        <div class="tag mb-2">Contrast · WCAG 2.2 AA, checked in CI</div>
        <div class="overflow-x-auto rounded-md border">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left text-muted-foreground">
                <th class="px-3 py-2 font-medium">Text</th>
                <th class="px-3 py-2 font-medium">On</th>
                <th class="px-3 py-2 font-medium">Needs</th>
                <th class="px-3 py-2 font-medium">Light</th>
                <th class="px-3 py-2 font-medium">Dark</th>
              </tr>
            </thead>
            <tbody>
              {CONTRAST_PAIRS.map((p) => (
                <tr class="border-b last:border-0">
                  <td class="mono px-3 py-1.5 text-xs">--{p.text}</td>
                  <td class="mono px-3 py-1.5 text-xs">--{p.surface}</td>
                  <td class="mono px-3 py-1.5 text-xs text-muted-foreground">{p.need}:1</td>
                  <td class={`mono px-3 py-1.5 text-xs ${p.light >= p.need ? "" : "text-destructive"}`}>{p.light.toFixed(2)}</td>
                  <td class={`mono px-3 py-1.5 text-xs ${p.dark >= p.need ? "" : "text-destructive"}`}>{p.dark.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
        </section>
        <p class="mono border-t border-border px-6 py-6 text-xs text-muted-foreground md:px-10">
          Every component above is the source a consumer installs — the shadcn tiers with the shadcn CLI, Intelligo's from intelligo.dev/r.
        </p>
      </div>
    </div>
  </section>
</Page>

<script>
  // The component in view is marked in the sidebar (and named in the phone
  // bar); the sidebar follows so the mark never scrolls out of sight.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
  const ids = [...new Set(links.map((a) => a.dataset.spy!))];
  const targets = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  const nav = document.querySelector<HTMLElement>("[data-components-nav]");
  const label = document.querySelector<HTMLElement>("[data-spy-label]");
  let current = "";
  let frame = 0;
  const update = () => {
    frame = 0;
    const line = window.innerHeight * 0.3;
    let active = targets[0];
    for (const t of targets) {
      if (t.getBoundingClientRect().top <= line) active = t;
      else break;
    }
    if (!active || active.id === current) return;
    current = active.id;
    for (const a of links) {
      if (a.dataset.spy === current) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    }
    if (label) label.textContent = links.find((a) => a.dataset.spy === current)?.dataset.label ?? "Tokens";
    const mark = nav?.querySelector<HTMLElement>(`[data-spy="${current}"]`);
    if (nav && mark) {
      const top = mark.offsetTop - nav.scrollTop;
      if (top < nav.clientHeight * 0.15 || top > nav.clientHeight * 0.75) {
        nav.scrollTo({ top: mark.offsetTop - nav.clientHeight / 3, behavior: "smooth" });
      }
    }
  };
  // Close the phone menu once a link is chosen.
  for (const a of links) a.addEventListener("click", () => a.closest("details")?.removeAttribute("open"));
  update();
  window.addEventListener("scroll", () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
  window.addEventListener("resize", update);
</script>
