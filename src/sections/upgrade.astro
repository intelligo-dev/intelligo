---
import SectionHead from "@/components/section-head.astro";
import { DoctorTerminal } from "@/components/doctor-terminal";

const STARTER = ["clone", "modify", "diverge", "maintain alone"];
const INTELLIGO = ["install", "customize", "upgrade", "keep shipping"];
const MECHANISMS = ["SemVer", "migrations shipped in core", "intelligo doctor", "migrate --check", "upgrade --check", "registry re-installs"];
---
<section id="upgrade" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="not a boilerplate"
      title="A boilerplate is a snapshot.<br />Intelligo keeps moving with your application."
      lede="Services stay versioned packages. Installed pages stay yours. A doctor that hashes every generated file refuses to overwrite what you changed."
    />
    <div class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:gap-10">
      <DoctorTerminal client:visible />

      <div class="reveal">
        <div class="grid grid-cols-2 gap-px border border-line bg-line">
          <div class="bg-paper p-4">
            <div class="mono text-[0.66rem] uppercase tracking-[0.08em] text-ink-faint">starter kit</div>
            <ol class="mono mt-3 space-y-1 text-[0.82rem]">
              {STARTER.map((s, i) => (
                <li class:list={["flex items-center gap-2", i === STARTER.length - 1 ? "text-fail" : "text-ink-dim"]}>
                  {i > 0 && <span class="text-ink-faint" aria-hidden="true">↓</span>}{s}
                </li>
              ))}
            </ol>
          </div>
          <div class="bg-paper-raised p-4">
            <div class="mono text-[0.66rem] uppercase tracking-[0.08em] text-amber">intelligo</div>
            <ol class="mono mt-3 space-y-1 text-[0.82rem]">
              {INTELLIGO.map((s, i) => (
                <li class:list={["flex items-center gap-2", i === INTELLIGO.length - 1 ? "text-settle" : "text-ink"]}>
                  {i > 0 && <span class="text-ink-faint" aria-hidden="true">↓</span>}{s}
                </li>
              ))}
            </ol>
          </div>
        </div>
        <div class="mt-4">
          <div class="tag">how</div>
          <div class="mono mt-2 flex flex-wrap gap-1 text-[0.72rem]">
            {MECHANISMS.map((m) => <span class="border border-line px-2 py-1 text-ink-dim">{m}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
