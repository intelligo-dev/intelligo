---
/**
 * What it looks like, once: the film, then the same pages live under
 * it. One section, so the page shows the product in one place.
 */
import Film from "@/sections/film.astro";
import Preview from "@/sections/preview.astro";
---
<section id="see-it" class="xline">
  <div class="space-y-16 px-6 py-14 md:space-y-20 md:px-10 md:py-20">
    <Film />
    <Preview />
  </div>
</section>
