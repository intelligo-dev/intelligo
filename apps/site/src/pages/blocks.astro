---
import Page from "@/layouts/Page.astro";
import { BlockCard } from "@/components/block-card";
import { Toaster } from "sonner";
import { REGISTRY_COUNT, REGISTRY_GROUPS, REGISTRY_ITEMS } from "@/lib/registry-items";
import { countWord } from "@/lib/count-words";
import { SITE } from "@/lib/site";

const Count = countWord(REGISTRY_COUNT);
---
<Page
  path="/blocks"
  tag="blocks · the registry"
  title={`${Count} blocks,<br />every one rendered.`}
  lede="The whole registry on one page. Each block below is the real component shadcn add installs, running with its own messages/en and fixture data. Until the registry moves to base-nova (ADR-0013), these previews still render the blocks' Radix-era primitives under the new tokens."
  description={`All ${REGISTRY_COUNT} Intelligo registry blocks, rendered live with their primitives, dependencies and install command.`}
>
  <section class="xline">
    <div class="flex flex-wrap gap-x-6 gap-y-2 px-6 py-6 md:px-10">
      {REGISTRY_GROUPS.map((g) => (
        <a href={`#group-${g.toLowerCase()}`} class="mono text-[0.78rem] text-foreground/70 hover:text-foreground">
          {g} <span class="text-muted-foreground">{REGISTRY_ITEMS.filter((i) => i.group === g).length}</span>
        </a>
      ))}
      <a href="/components" class="mono ml-auto text-[0.78rem] text-muted-foreground hover:text-foreground">primitives →</a>
    </div>
  </section>

  {REGISTRY_GROUPS.map((g) => (
    <section id={`group-${g.toLowerCase()}`} class="xline scroll-mt-20">
      <div class="px-6 py-10 md:px-10 md:py-14">
        <div class="section-head">
          <span class="tag">{g.toLowerCase()}</span>
          <h2 class="heading text-[1.5rem] font-medium">{g}</h2>
        </div>
        <div class="mt-8 space-y-14">
          {REGISTRY_ITEMS.filter((i) => i.group === g).map((item) => (
            <article id={item.name} class="scroll-mt-24">
              <BlockCard client:visible item={item} />
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="xline">
    <div class="px-6 py-8 md:px-10">
      <p class="mono text-[0.72rem] text-muted-foreground">
        Installed blocks are used as-is; what varies arrives through the config files they ship.
        <a href={`${SITE.adrs}/0010-registry-i18n-standard.md`} class="ml-1 hover:text-foreground">ADR-0010 →</a>
      </p>
    </div>
  </section>
  <Toaster client:idle position="bottom-right" richColors closeButton />
</Page>
