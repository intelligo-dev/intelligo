---
/**
 * A secondary page (/blocks, /components, /architecture, /why): same
 * nav, a page header instead of the hero, and the full width — only the
 * homepage sits between the 1152px rails, so here the nav and the
 * footer run the full width with the page. Docs have their own layout.
 */
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import Base from "@/layouts/Base.astro";
import Footer from "@/components/footer.astro";
import { Nav } from "@/components/nav";
import { SITE } from "@/lib/site";

interface Props {
  path: string;
  tag: string;
  title: string;
  lede?: string;
  description?: string;
  noindex?: boolean;
  /** Centre the header and the closing row in a 1280px column, for a page whose body sits in one. */
  contained?: boolean;
}
const { path, tag, title, lede, description, noindex, contained } = Astro.props;
const pageTitle = `${title.replace(/<br\s*\/?>/g, " ")} — ${SITE.name}`;
---
<Base title={pageTitle} description={description ?? lede ?? SITE.description} noindex={noindex}>
  <Nav client:load current={path} wide />
  <main id="main" class="rails-full">
    <header class="xline">
      <div class:list={["px-6 pb-10 pt-14 md:px-10 md:pb-12 md:pt-20", contained && "mx-auto max-w-7xl"]}>
        <div class="section-head">
          <span class="tag">{tag}</span>
          <h1 class="heading text-[clamp(1.9rem,3.4vw,3rem)] font-medium leading-[1.04] tracking-[-0.01em]" set:html={title} />
          {lede && <p class="mt-3 max-w-[60ch] text-[1rem] text-muted-foreground">{lede}</p>}
        </div>
      </div>
    </header>
    <slot />
    <section class="xline">
      <div class:list={["flex flex-wrap items-center justify-between gap-4 px-6 py-10 md:px-10 md:py-14", contained && "mx-auto max-w-7xl"]}>
        <p class="text-[0.95rem] text-muted-foreground">Ready to try it? Three commands and the app runs against a stub model.</p>
        <div class="flex items-center gap-2">
          <a href={SITE.github} class={cn(buttonVariants({ variant: "outline" }), "border-foreground/20")}>GitHub</a>
          <a href={SITE.docs} class={cn(buttonVariants({ variant: "outline" }), "border-foreground/20")}>Docs</a>
          <a href={SITE.start} class={buttonVariants()}>Get started</a>
        </div>
      </div>
    </section>
  </main>
  <div class="rails-full"><Footer /></div>
</Base>
