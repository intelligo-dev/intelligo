---
import SectionHead from "@/components/section-head.astro";
import { BoundaryCode } from "@/components/boundary-code";
import { SITE } from "@/lib/site";
---
<section id="boundary" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="the execution boundary"
      title="Every AI run is bracketed,<br />never wrapped."
      lede="Intelligo admits, settles and records the run. Your framework does the rest, unmodified."
    />
    <div class="mt-8">
      <BoundaryCode client:visible />
    </div>
    <p class="mono mt-6 text-[0.72rem] text-ink-faint">
      <a href={`${SITE.adrs}/0003-ai-framework-boundary.md`} class="hover:text-ink">ADR-0003 · AI frameworks stay native</a>
      <span aria-hidden="true"> · </span>
      <a href={`${SITE.adrs}/0007-execution-boundary.md`} class="hover:text-ink">ADR-0007 · a lifecycle with ports, not a wrapper</a>
    </p>
  </div>
</section>
