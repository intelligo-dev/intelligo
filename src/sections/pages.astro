---
import SectionHead from "@/components/section-head.astro";
import { RegistryExplorer } from "@/components/registry-explorer";
import { REGISTRY_COUNT } from "@/lib/registry-items";
import { SITE } from "@/lib/site";

const words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen", "twenty", "twenty-one", "twenty-two", "twenty-three", "twenty-four", "twenty-five", "twenty-six", "twenty-seven", "twenty-eight", "twenty-nine", "thirty"];
const count = words[REGISTRY_COUNT] ?? String(REGISTRY_COUNT);
const Count = count.charAt(0).toUpperCase() + count.slice(1);
---
<section id="pages" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="installed, not imported"
      title={`${Count} page families,<br />shipped as your own source.`}
      lede="Installed with the shadcn CLI. No runtime UI package, nothing to fork later."
    />

    <div class="reveal mt-6 grid gap-px border border-line bg-line md:grid-cols-3">
      {[
        ["Used as-is.", "Variance lives in config files the items ship."],
        ["Copy is translation, not code.", "Add a language by adding message files."],
        ["Rules live behind the pages.", "Actions parse, call a service, map the error."],
      ].map(([h, b]) => (
        <div class="bg-paper p-4">
          <div class="text-[0.95rem] font-semibold text-ink">{h}</div>
          <p class="mt-1 text-[0.86rem] text-ink-dim">{b}</p>
        </div>
      ))}
    </div>

    <div class="mt-8">
      <RegistryExplorer client:visible />
    </div>
    <p class="mono mt-4 text-[0.72rem] text-ink-faint">
      Installed from the built artifact today; an HTTP registry follows the first release. <a href={`${SITE.adrs}/0010-registry-i18n-standard.md`} class="ml-1 hover:text-ink">ADR-0010 →</a>
    </p>
  </div>
</section>
