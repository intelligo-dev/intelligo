---
import SectionHead from "@/components/section-head.astro";
import { Assembly } from "@/components/assembly";
---
<section id="assembly" class="xline">
  <div class="px-6 pt-14 md:px-10 md:pt-20">
    <SectionHead
      n="01"
      tag="the assembly"
      title="Keep scrolling.<br />Watch a SaaS assemble around your agent."
      lede="Every part that lands is a package on npm or a page in the registry — the shell, identity, commerce, execution accounting, product surfaces, operations. The last slot is the only one you write."
    />
  </div>
  <div class="px-6 md:px-10">
    <Assembly client:load />
  </div>
</section>
