{
  "name": "@intelligo-dev/audit",
  "version": "1.0.0-beta.9",
  "description": "Append-only audit events for multi-tenant apps, with a Postgres trigger that refuses every update and delete.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "audit-log",
    "append-only",
    "postgres"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-dev/intelligo.git",
    "directory": "packages/audit"
  },
  "homepage": "https://intelligo.dev/docs/packages/audit",
  "bugs": {
    "url": "https://github.com/intelligo-dev/intelligo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/schema.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./db": {
        "types": "./dist/db/schema.d.ts",
        "default": "./dist/db/schema.js"
      }
    }
  },
  "engines": {
    "node": ">=22.14"
  },
  "sideEffects": false
}
