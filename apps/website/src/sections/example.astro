---
/**
 * Straight after the title card: one real product on the framework, so
 * "vertical AI SaaS" and "the other half" land on something concrete
 * before anything is explained (lib/example.ts).
 */
import SectionHead from "@/components/section-head.astro";
import { EXAMPLE } from "@/lib/example";

const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inline = (text: string) =>
  escape(text).replace(/`([^`]+)`/g, '<code class="mono text-[0.85em] text-foreground">$1</code>');
---
<section id="example" class="xline">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <div class="px-6 py-14 md:px-10 md:py-20">
      <SectionHead
        tag="built on it"
        title="One product,<br />in five lines."
      />
      <p class="reveal mt-6 max-w-[48ch] text-[0.98rem] leading-relaxed text-foreground/70">
        <a href={EXAMPLE.url} class="font-semibold text-foreground hover:underline">{EXAMPLE.name}</a>{" "}{EXAMPLE.lede}
      </p>
      <a href={EXAMPLE.url} class="mono mt-6 inline-block text-[0.75rem] text-muted-foreground hover:text-foreground">{EXAMPLE.host} ↗</a>
    </div>
    <ol class="reveal border-t border-border lg:border-l lg:border-t-0">
      {EXAMPLE.lines.map((line, i) => (
        <li class="flex gap-4 border-b border-border px-6 py-4 last:border-b-0 md:px-10 md:py-5">
          <span class="mono mt-0.5 text-[0.72rem] tabular-nums text-muted-foreground">0{i + 1}</span>
          <span class="text-[0.95rem] leading-snug text-foreground/85" set:html={inline(line)} />
        </li>
      ))}
    </ol>
  </div>
</section>
