---
import Page from "@/layouts/Page.astro";
import { PackageMap } from "@/components/package-map";
import { RuleToggles } from "@/components/rule-toggles";
import { PROOF } from "@/lib/proof";


const OWNERSHIP = [
  ["Packages", "Versioned on npm as @intelligo-dev/*. Services, schema, migrations. Upgraded with SemVer; never edited in place."],
  ["Generated source", "What intelligo create writes: the composition root, plans, i18n routing. Hashed in intelligo.manifest.json so doctor and upgrade --check know what you changed."],
  ["Installed pages", "What shadcn add writes from the registry. Yours from the first commit; re-install to take an update."],
  ["Your agent", "Prompts, tools, knowledge, evals — in your AI framework. Intelligo has no import into it."],
];
---
<Page
  path="/architecture"
  tag="architecture"
  title={`${PROOF.packages} packages, one database,<br />and the rules that hold them apart.`}
  lede="The full package graph, the dependency rules as the tests that enforce them, and who owns which files."
  description="The Intelligo architecture: package dependency graph, boundaries enforced as tests, and the ownership model."
>
  <section id="packages" class="xline">
    <div class="px-6 py-10 md:px-10 md:py-14">
      <div class="section-head">
        <span class="tag">the package graph</span>
        <h2>Real imports. Hover to see them, click to see what each owns.</h2>
      </div>
      <div class="mt-6">
        <PackageMap client:load />
      </div>
      <p class="mono mt-4 text-[0.72rem] text-muted-foreground">
        No <span class="text-foreground/70">auth → billing</span>, no <span class="text-foreground/70">executions → anything</span> — the dependency-direction test fails the build otherwise.
      </p>
    </div>
  </section>

  <section id="rules" class="xline">
    <div class="px-6 py-10 md:px-10 md:py-14">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-12">
        <div class="section-head">
          <span class="tag">architecture as failing tests</span>
          <h2>Enforced by tests,<br />not by a style guide.</h2>
          <p>Break a rule and read the assertion the real test emits. {PROOF.architectureTests} suites run on every commit alongside the unit and real-database tests.</p>
        </div>
        <RuleToggles client:visible />
      </div>
    </div>
  </section>

  <section id="ownership" class="xline">
    <div class="px-6 py-10 md:px-10 md:py-14">
      <div class="section-head">
        <span class="tag">ownership</span>
        <h2>Four kinds of file. Four owners.</h2>
      </div>
      <div class="mt-6 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
        {OWNERSHIP.map(([h, b]) => (
          <div class="bg-background p-4">
            <div class="text-[0.98rem] font-semibold text-foreground">{h}</div>
            <p class="mt-1 text-[0.86rem] text-foreground/70">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Page>
