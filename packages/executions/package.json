{
  "name": "@intelligo-dev/executions",
  "version": "1.0.0-beta.9",
  "description": "The execution lifecycle (admission, running, settlement) and the model cost registry.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "llm",
    "usage",
    "cost",
    "metering",
    "execution-boundary"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-dev/intelligo.git",
    "directory": "packages/executions"
  },
  "homepage": "https://intelligo.dev/docs/packages/executions",
  "bugs": {
    "url": "https://github.com/intelligo-dev/intelligo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pricing": "./src/pricing.ts",
    "./db": "./src/db/schema.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/audit": "workspace:*",
    "@intelligo-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.2",
    "pg": "8.18.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./pricing": {
        "types": "./dist/pricing.d.ts",
        "default": "./dist/pricing.js"
      },
      "./db": {
        "types": "./dist/db/schema.d.ts",
        "default": "./dist/db/schema.js"
      }
    }
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "engines": {
    "node": ">=22.14"
  },
  "sideEffects": false
}
