---
import SectionHead from "@/components/section-head.astro";
import { Assembly } from "@/components/assembly";
---
<section id="assembly" class="xline">
  <div class="px-6 pt-14 md:px-10 md:pt-20">
    <SectionHead
      n="01"
      tag="the assembly"
      title="Keep scrolling.<br />Watch a SaaS build itself, in three acts."
      lede="Blocks compose every page family in the registry. A terminal creates the app and installs the packages. The parts lock into one running application — and the last slot to land is your agent."
    />
  </div>
  <div class="px-6 md:px-10">
    <Assembly client:load />
  </div>
</section>
