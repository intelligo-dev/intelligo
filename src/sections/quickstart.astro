---
import SectionHead from "@/components/section-head.astro";
import { Quickstart } from "@/components/quickstart";
---
<section id="quickstart" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="quickstart"
      title="Running before you touch a model key."
      lede="Chat streams against a built-in stub model, so the whole app runs before you configure a provider."
    />
    <div class="mt-8">
      <Quickstart client:visible />
    </div>
    <p class="mono mt-4 text-[0.72rem] text-ink-faint">
      Not on npm yet — install from a clone. <span class="text-ink-dim">pnpm dev</span> serves the reference app.
    </p>
  </div>
</section>
