{
  "name": "@intelligo-dev/auth",
  "version": "1.0.0-beta.9",
  "description": "Multi-tenant authentication on Better-Auth: sign-up, workspaces, invitations and role-based access control.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "authentication",
    "better-auth",
    "multi-tenant",
    "rbac",
    "workspaces"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-dev/intelligo.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/intelligo-dev/intelligo#readme",
  "bugs": {
    "url": "https://github.com/intelligo-dev/intelligo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./edge": "./src/edge.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/core": "workspace:*",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "better-auth": "~1.6.30",
    "drizzle-orm": "^0.45.1",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "better-auth": "~1.6.33",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./src/client.ts",
        "default": "./dist/client.js"
      },
      "./edge": {
        "types": "./src/edge.ts",
        "default": "./dist/edge.js"
      }
    }
  },
  "engines": {
    "node": ">=22.14"
  }
}
