---
import SectionHead from "@/components/section-head.astro";
import { PROOF, PROOF_STATS } from "@/lib/proof";
import { SITE } from "@/lib/site";
import { Scale, FileText, ShieldCheck, GitPullRequest, type LucideIcon } from "lucide-react";

/** How the project is run, every link a real file in the repository. */
const OPEN: { icon: LucideIcon; title: string; body: string; href: string; cta: string }[] = [
  {
    icon: Scale,
    title: "Apache-2.0",
    body: "Use it commercially, fork it, ship it. No open-core split.",
    href: SITE.license,
    cta: "LICENSE",
  },
  {
    icon: FileText,
    title: `${PROOF.adrs} decisions, in writing`,
    body: "Every boundary that matters is an ADR, with the alternatives that lost.",
    href: SITE.adrs,
    cta: "docs/adr",
  },
  {
    icon: ShieldCheck,
    title: "Architecture as tests",
    body: `${PROOF.architectureTests} suites fail the build on a wrong import, an unregistered model id or a drifting registry item.`,
    href: `${SITE.github}/tree/main/tests/architecture`,
    cta: "tests/architecture",
  },
  {
    icon: GitPullRequest,
    title: "Small, scoped, green",
    body: "Conventional commits, SemVer releases from a tag, green after every slice.",
    href: `${SITE.github}/blob/main/CONTRIBUTING.md`,
    cta: "CONTRIBUTING",
  },
];
---
<section id="proof" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      n="07"
      tag="open source · engineering proof"
      title="Not a pitch. A count."
      lede="Counted from the framework repository, not typed into a landing page — and every decision behind the numbers is public."
    />
    <div class="reveal mt-8 grid gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {PROOF_STATS.map((s) => (
        <div class="bg-paper-raised p-5 top-shade">
          <div class="heading text-[2.6rem] font-semibold leading-none tabular-nums text-ink">{s.value}</div>
          <div class="mono mt-2 text-[0.66rem] uppercase tracking-[0.08em] text-ink-faint">{s.label}</div>
          <p class="mt-3 text-[0.82rem] text-ink-dim">{s.note}</p>
        </div>
      ))}
    </div>
    <p class="mono mt-3 text-[0.7rem] text-ink-faint">
      counted {PROOF.sampledAt} · v{PROOF.version} · <a href={`${SITE.github}/blob/main/apps/site/scripts/sync-framework.mjs`} class="hover:text-ink">by a script, committed with the site →</a>
    </p>

    <ul class="reveal mt-8 grid gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {OPEN.map(({ icon: Icon, title, body, href, cta }) => (
        <li>
          <a href={href} class="group flex h-full items-start gap-3 bg-paper px-4 py-3.5 no-underline transition-colors hover:bg-paper-raised">
            <Icon className="mt-0.5 size-4 shrink-0 text-ink-dim transition-colors group-hover:text-ink" strokeWidth={1.75} aria-hidden="true" />
            <span class="min-w-0">
              <span class="block text-[0.9rem] font-semibold text-ink">{title}</span>
              <span class="mt-0.5 block text-[0.8rem] leading-snug text-ink-dim">{body}</span>
              <span class="mono mt-2 block text-[0.68rem] text-ink-faint transition-colors group-hover:text-ink">{cta} →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
