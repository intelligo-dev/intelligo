{
  "name": "@intelligo-dev/executions",
  "version": "1.0.0-beta.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-mn/framework.git",
    "directory": "packages/executions"
  },
  "homepage": "https://github.com/intelligo-mn/framework#readme",
  "bugs": {
    "url": "https://github.com/intelligo-mn/framework/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pricing": "./src/pricing.ts",
    "./db": "./src/db/schema.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/audit": "workspace:*",
    "@intelligo-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.18.0",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./pricing": {
        "types": "./dist/pricing.d.ts",
        "default": "./dist/pricing.js"
      },
      "./db": {
        "types": "./dist/db/schema.d.ts",
        "default": "./dist/db/schema.js"
      }
    }
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
