---
/**
 * The homepage, in the order a reader asks: what is it (the title
 * card); what does it look like (the film, then the same pages live);
 * how does it work and why trust it (the two halves, what you take
 * home, the boundary in code, the count); how do I start (the
 * quickstart); the questions. Each section is a door into /why,
 * /blocks, /components, /architecture or /docs.
 */
import Base from "@/layouts/Base.astro";
import Footer from "@/components/footer.astro";
import { Nav } from "@/components/nav";
import Hero from "@/sections/hero.astro";
import SeeIt from "@/sections/see-it.astro";
import Halves from "@/sections/halves.astro";
import WhatYouGet from "@/sections/what-you-get.astro";
import Code from "@/sections/code.astro";
import Proof from "@/sections/proof.astro";
import Quickstart from "@/sections/quickstart.astro";
import Faq from "@/sections/faq.astro";
---
<Base>
  <Nav client:load current="/" />
  <main id="main" class="rails">
    <Hero />
    <SeeIt />
    <Halves />
    <WhatYouGet />
    <Code />
    <Proof />
    <Quickstart />
    <Faq />
  </main>
  <div class="rails"><Footer /></div>
</Base>
