---
import { Font } from "astro:assets";
import "../styles/global.css";
import { SITE } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  /**
   * Page-specific JSON-LD (one object, or several — a docs page pairs a
   * `TechArticle` with a `BreadcrumbList`). Defaults to describing the
   * framework itself, right for the homepage and every page that doesn't
   * override it; a docs or catalog page should pass its own so a crawler
   * gets a signal for what kind of page it actually is, not the same
   * software-project schema everywhere.
   */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** A page that should not be indexed (the 404): no canonical either. */
  noindex?: boolean;
}
const { title = SITE.title, description = SITE.description, structuredData, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
const DEFAULT_STRUCTURED_DATA = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Intelligo",
  description: SITE.description,
  url: Astro.site?.href,
  codeRepository: SITE.github,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  programmingLanguage: "TypeScript",
  runtimePlatform: "Node.js",
  version: SITE.version,
};
const jsonLd = JSON.stringify(
  structuredData
    ? [structuredData].flat().map((d) => ({ "@context": "https://schema.org", ...d }))
    : DEFAULT_STRUCTURED_DATA
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#fcfcfc" />
    <meta property="og:site_name" content="Intelligo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-geist" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-outfit" preload={[{ weight: 500 }, { weight: 700 }]} />
    <Font cssVariable="--font-geist-mono" />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      // Put `dark` on <html> before first paint so tokens and `dark:` agree,
      // and mark the document as scripted so reveal-on-scroll can hide
      // content — without JS everything stays visible. The browser's own
      // chrome follows the class too (the page's --background, either
      // theme), whoever flips it: the OS, or the toggle in the footer.
      (function () {
        document.documentElement.classList.add("js");
        var chrome = function () {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute("content", document.documentElement.classList.contains("dark") ? "#151515" : "#fcfcfc");
        };
        new MutationObserver(chrome).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        try {
          var stored = localStorage.getItem("theme");
          var mq = window.matchMedia("(prefers-color-scheme: dark)");
          var apply = function () {
            var t = stored === "light" || stored === "dark" ? stored : mq.matches ? "dark" : "light";
            document.documentElement.classList.toggle("dark", t === "dark");
          };
          apply();
          mq.addEventListener("change", function () {
            stored = localStorage.getItem("theme");
            apply();
          });
        } catch (e) {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      // Copy, by delegation: every `[data-copy]` button on any page. It
      // copies its own `data-copy-text`, or the code frame it sits in. A
      // failure is shown as one — it must not look like a copy.
      document.addEventListener("click", async (event) => {
        const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-copy]");
        if (!button) return;
        const label = button.getAttribute("aria-label") ?? "Copy";
        const text =
          button.dataset.copyText ??
          (button.closest(".code-frame")?.querySelector("pre")?.innerText ?? "").replace(/\n$/, "");
        const settle = (key: "copied" | "failed", say: string, ms: number) => {
          button.dataset[key] = "";
          button.setAttribute("aria-label", say);
          setTimeout(() => {
            delete button.dataset[key];
            button.setAttribute("aria-label", label);
          }, ms);
        };
        try {
          await navigator.clipboard.writeText(text);
          settle("copied", "Copied", 1600);
        } catch {
          settle("failed", "Copy failed — select the text instead", 2400);
        }
      });

      // Scroll reveal: flip .reveal → .is-in once.
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-in"));
      }
    </script>
  </body>
</html>
