{
  "name": "@intelligo-dev/chat",
  "version": "1.0.0-beta.14",
  "description": "The AI-SDK-native chat transport: one Route Handler with auth, rate limits, feature gates, credits and persistence.",
  "keywords": [
    "intelligo",
    "ai-saas",
    "saas",
    "typescript",
    "ai-sdk",
    "chat",
    "streaming",
    "llm"
  ],
  "license": "Apache-2.0",
  "author": "Turtuvshin Byambaa <toroo.byamba@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-dev/intelligo.git",
    "directory": "packages/chat"
  },
  "homepage": "https://intelligo.dev/docs/packages/chat",
  "bugs": {
    "url": "https://github.com/intelligo-dev/intelligo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/auth": "workspace:*",
    "@intelligo-dev/billing": "workspace:*",
    "@intelligo-dev/core": "workspace:*",
    "@intelligo-dev/executions": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "ai": "^7.0.107",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "engines": {
    "node": ">=22.14"
  },
  "sideEffects": false
}
