{
  "name": "@intelligo-dev/billing-core",
  "version": "1.0.0-beta.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-mn/framework.git",
    "directory": "packages/billing-core"
  },
  "homepage": "https://github.com/intelligo-mn/framework#readme",
  "bugs": {
    "url": "https://github.com/intelligo-mn/framework/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plans": "./src/plans.ts",
    "./plan-registry": "./src/plan-registry.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@intelligo-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-orm": "^0.45.1",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./plans": {
        "types": "./dist/plans.d.ts",
        "default": "./dist/plans.js"
      },
      "./plan-registry": {
        "types": "./dist/plan-registry.d.ts",
        "default": "./dist/plan-registry.js"
      }
    }
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
