{
  "name": "@intelligo-dev/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligo-mn/framework.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/intelligo-mn/framework#readme",
  "bugs": {
    "url": "https://github.com/intelligo-mn/framework/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./email": "./src/email/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./conversations": "./src/conversations/index.ts",
    "./documents": "./src/documents/index.ts",
    "./identity": "./src/identity/index.ts",
    "./env": "./src/env.ts",
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./src/logger.ts",
      "default": "./src/logger.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "tsx scripts/check-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@react-email/components": "^1.0.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "resend": "^6.9.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.10",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.8",
    "next": "^16.0.7",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "src/db/migrations"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./db": {
        "types": "./dist/db/index.d.ts",
        "default": "./dist/db/index.js"
      },
      "./db/schema": {
        "types": "./dist/db/schema/index.d.ts",
        "default": "./dist/db/schema/index.js"
      },
      "./email": {
        "types": "./dist/email/index.d.ts",
        "default": "./dist/email/index.js"
      },
      "./notifications": {
        "types": "./dist/notifications/index.d.ts",
        "default": "./dist/notifications/index.js"
      },
      "./conversations": {
        "types": "./dist/conversations/index.d.ts",
        "default": "./dist/conversations/index.js"
      },
      "./documents": {
        "types": "./dist/documents/index.d.ts",
        "default": "./dist/documents/index.js"
      },
      "./identity": {
        "types": "./dist/identity/index.d.ts",
        "default": "./dist/identity/index.js"
      },
      "./env": {
        "types": "./dist/env.d.ts",
        "default": "./dist/env.js"
      },
      "./logger": {
        "types": "./dist/logger.d.ts",
        "import": "./dist/logger.js",
        "default": "./dist/logger.js"
      }
    }
  }
}
