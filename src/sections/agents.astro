---
import SectionHead from "@/components/section-head.astro";
import { BlockerCards } from "@/components/blocker-cards";
---
<section id="agents" class="xline">
  <div class="px-6 py-14 md:px-10 md:py-20">
    <SectionHead
      tag="the agent objection"
      title="Your agent is good.<br />It doesn't know what it doesn't know."
      lede="Three ways a well-prompted agent still gets the boring half wrong."
    />
    <div class="mt-4">
      <BlockerCards client:visible />
    </div>
  </div>
</section>
