---
/**
 * A docs page: the site's nav, the full width, a section sidebar, the article,
 * an on-page contents list with the section you are reading marked, and
 * prev/next in reading order. Shares the token contract with every other
 * page, so the theme toggle and the design system reach the docs
 * unchanged. Code blocks arrive framed from the markdown pipeline
 * (lib/markdown.mjs); the script below copies them and tracks the TOC.
 *
 * The right rail exists from `xl` up. Below it nothing in it is lost: the
 * contents list opens from the bar under the nav, beside the page list,
 * and the edit link and the way back up sit under the article.
 */
import Base from "@/layouts/Base.astro";
import Footer from "@/components/footer.astro";
import { Nav } from "@/components/nav";
import { SITE } from "@/lib/site";
import { docsSidebar } from "@/lib/docs-nav";
import type { MarkdownHeading } from "astro";

interface Props {
  path: string;
  section: string;
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
  /** Repository path of the source file, for the edit link. */
  source?: string;
}
const { path, section, title, description, headings = [], prev, next, source } = Astro.props;
const sidebar = await docsSidebar();
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const current = sidebar.flatMap((s) => s.items).find((i) => i.href === path);
const canonical = new URL(path, Astro.site).href;
const structuredData = [
  {
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    isPartOf: { "@type": "WebSite", name: SITE.name, url: Astro.site?.href },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Docs", item: new URL("/docs", Astro.site).href },
      ...(section !== "Docs"
        ? [{ "@type": "ListItem", position: 2, name: section }]
        : []),
    ],
  },
];
---
<Base title={`${title} — ${SITE.name} docs`} description={description} structuredData={structuredData}>
  <Nav client:load current={path} wide />
  <main id="main" class="rails-full">
    <div class="grid grid-cols-1 border-t border-border lg:grid-cols-[248px_minmax(0,1fr)] xl:grid-cols-[248px_minmax(0,1fr)_216px]">
      <aside class="hidden border-r border-border lg:block">
        <nav aria-label="Docs" class="docs-scroll sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto px-5 pb-10 pt-8" data-docs-sidebar>
          {sidebar.map((s) => (
            <div class="mb-7 last:mb-0">
              <div class="docs-section-title">{s.title}</div>
              <ul class="docs-rail">
                {s.items.map((i) => (
                  <li>
                    <a
                      href={i.href}
                      aria-current={i.href === path ? "page" : undefined}
                      class:list={["docs-link", i.code && "mono text-[0.8rem]"]}
                    >{i.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <div class="min-w-0">
        <details class="docs-mobile-menu group sticky top-14 z-sticky border-b border-border bg-background/90 backdrop-blur-md lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-6 py-3">
            <span class="flex min-w-0 items-center gap-2 text-[0.85rem]">
              <span class="text-muted-foreground">{section}</span>
              <span class="text-muted-foreground" aria-hidden="true">/</span>
              <span class="truncate font-medium text-foreground">{current?.label ?? title}</span>
            </span>
            <span class="mono flex shrink-0 items-center gap-1.5 rounded-full border border-input px-2.5 py-1 text-[0.72rem] text-foreground">
              Menu
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-normal group-open:rotate-180"><path d="m6 9 6 6 6-6" /></svg>
            </span>
          </summary>
          <nav aria-label="Docs" class="docs-scroll max-h-[70dvh] overflow-y-auto border-t border-border px-6 pb-6 pt-4" data-docs-menu>
            {toc.length > 1 && (
              <div class="mb-5">
                <div class="docs-section-title">On this page</div>
                <ul class="docs-rail">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} data-toc={h.slug} data-menu-close class:list={["docs-link", h.depth === 3 && "pl-6"]}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {sidebar.map((s) => (
              <div class="mb-5 last:mb-0">
                <div class="docs-section-title">{s.title}</div>
                <ul class="docs-rail">
                  {s.items.map((i) => (
                    <li>
                      <a href={i.href} aria-current={i.href === path ? "page" : undefined} class:list={["docs-link", i.code && "mono text-[0.8rem]"]}>{i.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </details>

        <article class="px-6 pb-12 pt-10 md:px-10 md:pt-14">
          <header class="mb-10">
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[0.8rem] text-muted-foreground">
              <a href="/docs" class="no-underline hover:text-foreground">Docs</a>
              {section !== "Docs" && (
                <>
                  <span aria-hidden="true">/</span>
                  <span>{section}</span>
                </>
              )}
            </nav>
            <h1 class="heading mt-3 text-[clamp(1.9rem,3.2vw,2.6rem)] font-medium leading-[1.08] tracking-[-0.01em]">{title}</h1>
            <p class="mt-4 max-w-[62ch] text-[1.05rem] leading-relaxed text-muted-foreground">{description}</p>
          </header>
          <div class="docs-prose">
            <slot />
          </div>

          <nav aria-label="Previous and next" class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2">
            {prev ? (
              <a href={prev.href} class="docs-pager">
                <span class="mono block text-[0.68rem] uppercase tracking-[0.08em] text-muted-foreground">Previous</span>
                <span class="mt-1 block text-[0.95rem] font-medium text-foreground">← {prev.label}</span>
              </a>
            ) : <span class="hidden sm:block" />}
            {next && (
              <a href={next.href} class="docs-pager sm:text-right">
                <span class="mono block text-[0.68rem] uppercase tracking-[0.08em] text-muted-foreground">Next</span>
                <span class="mt-1 block text-[0.95rem] font-medium text-foreground">{next.label} →</span>
              </a>
            )}
          </nav>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-[0.85rem] xl:hidden">
            {source && (
              <a href={`${SITE.github}/edit/main/${source}`} class="py-2 text-muted-foreground no-underline hover:text-foreground">Edit this page ↗</a>
            )}
            <a href="#main" class="py-2 text-muted-foreground no-underline hover:text-foreground" data-docs-top>Back to top ↑</a>
          </div>
        </article>
      </div>

      <aside class="hidden border-l border-border xl:block">
        <div class="docs-scroll sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto px-5 pb-10 pt-8">
          {toc.length > 1 && (
            <nav aria-label="On this page" data-docs-toc>
              <div class="docs-section-title">On this page</div>
              <ul class="docs-rail">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-toc={h.slug} class:list={["docs-link text-[0.8rem]", h.depth === 3 && "pl-6"]}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <div class:list={["space-y-2 text-[0.8rem]", toc.length > 1 && "mt-8 border-t border-border pt-5"]}>
            {source && (
              <a href={`${SITE.github}/edit/main/${source}`} class="block text-muted-foreground no-underline hover:text-foreground">Edit this page ↗</a>
            )}
            <a href="#main" class="block text-muted-foreground no-underline hover:text-foreground" data-docs-top>Back to top ↑</a>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <div class="rails-full"><Footer /></div>
</Base>

<script>
  // Copy: every framed code block, by delegation.
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-copy]");
    if (!button) return;
    const code = button.closest(".code-frame")?.querySelector("pre")?.innerText ?? "";
    try {
      await navigator.clipboard.writeText(code.replace(/\n$/, ""));
      button.dataset.copied = "";
      button.setAttribute("aria-label", "Copied");
      setTimeout(() => {
        delete button.dataset.copied;
        button.setAttribute("aria-label", "Copy code");
      }, 1600);
    } catch {
      // seen, not only announced: a failed copy must not look like a copy
      button.dataset.failed = "";
      button.setAttribute("aria-label", "Copy failed — select the code instead");
      setTimeout(() => {
        delete button.dataset.failed;
        button.setAttribute("aria-label", "Copy code");
      }, 2400);
    }
  });

  // The current page in view in the sidebar, without scrolling the page.
  const sidebar = document.querySelector<HTMLElement>("[data-docs-sidebar]");
  const active = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
  if (sidebar && active) {
    const top = active.offsetTop - sidebar.clientHeight / 3;
    if (top > 0) sidebar.scrollTop = top;
  }

  // A wide table scrolls in a wrapper a keyboard can reach; the table
  // itself stays a table (see .table-scroll in global.css).
  for (const table of document.querySelectorAll<HTMLTableElement>(".docs-prose table")) {
    const wrap = document.createElement("div");
    wrap.className = "table-scroll";
    wrap.setAttribute("role", "region");
    wrap.setAttribute("aria-label", "Table");
    wrap.tabIndex = 0;
    table.before(wrap);
    wrap.append(table);
  }

  // A hover anchor on each h2/h3, so a section can be linked to.
  for (const h of document.querySelectorAll<HTMLElement>(".docs-prose h2[id], .docs-prose h3[id]")) {
    const a = document.createElement("a");
    a.href = `#${h.id}`;
    a.className = "heading-anchor";
    a.setAttribute("aria-label", `Link to ${h.textContent ?? "this section"}`);
    a.textContent = "#";
    h.append(a);
  }

  // The same, in the menu under the nav, each time it opens; and a link
  // to a section on this page closes it, or it would cover the section.
  const menu = document.querySelector<HTMLDetailsElement>(".docs-mobile-menu");
  menu?.addEventListener("toggle", () => {
    const list = menu.querySelector<HTMLElement>("[data-docs-menu]");
    const here = list?.querySelector<HTMLElement>('[aria-current="page"]');
    if (menu.open && list && here) list.scrollTop = Math.max(0, here.offsetTop - list.clientHeight / 3);
  });
  for (const a of document.querySelectorAll("[data-menu-close]")) {
    a.addEventListener("click", () => menu?.removeAttribute("open"));
  }

  // Back to top: to the very top, not to where <main> starts under the
  // nav — and without the glide for a reader who asked for less motion.
  for (const top of document.querySelectorAll("[data-docs-top]")) {
    top.addEventListener("click", (event) => {
      event.preventDefault();
      const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
    });
  }

  // The TOC marks the section being read: the last heading above the upper third.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const headings = links
    .map((a) => document.getElementById(a.dataset.toc!))
    .filter((h): h is HTMLElement => !!h);
  if (headings.length) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.3;
      let current = headings[0]!;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= line) current = h;
        else break;
      }
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atEnd) current = headings[headings.length - 1]!;
      for (const a of links) {
        if (a.dataset.toc === current.id) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      }
    };
    update();
    window.addEventListener("scroll", () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
