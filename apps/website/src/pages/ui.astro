---
/**
 * Intelligo UI: the door to both galleries. Components stand on their own
 * in any shadcn project; pages are the product's screens and need the
 * packages behind them — the page says which is which. Counts come from
 * the synced registry, never typed in.
 */
import Page from "@/layouts/Page.astro";
import CopyLine from "@/components/copy-line.astro";
import { installCommand } from "@/lib/install";
import { CATALOG, INTELLIGO } from "@/lib/primitives";
import { REGISTRY_COUNT, REGISTRY_GROUPS, REGISTRY_ITEMS } from "@/lib/registry-items";
import { SITE } from "@/lib/site";

const AI_PARTS = INTELLIGO.filter((c) => c.tier === "T3");

const DOORS = [
  {
    n: String(INTELLIGO.length),
    title: "Components",
    needs: "no framework required",
    body: `${AI_PARTS.length} AI parts — messages, reasoning, tool calls, approvals, citations, artifacts — and ${INTELLIGO.length - AI_PARTS.length} patterns and motion pieces, beside ${CATALOG.length} primitives and composites. One token contract, WCAG AA contrast checked in CI. They import nothing from Intelligo's packages, so they drop into any shadcn project.`,
    chips: AI_PARTS.slice(0, 8).map((c) => c.name.replace(/^ai-/, "")),
    href: "/components",
    cta: "open the components",
  },
  {
    n: String(REGISTRY_COUNT),
    title: "Pages",
    needs: "with the packages",
    body: "The product's own screens — sign-up, the shell, dashboard, team, billing, usage, chat — installed into your repository as your source. These are wired to the services behind them, and you vary them through config and message files rather than forks.",
    chips: REGISTRY_GROUPS.map((g) => `${g.toLowerCase()} ${REGISTRY_ITEMS.filter((i) => i.group === g).length}`),
    href: "/blocks",
    cta: "see every page, live",
  },
];
---
<Page
  path="/ui"
  tag="intelligo ui"
  title="The screens, and the parts they are made of."
  lede="Everything here installs with the standard shadcn CLI and lands in your repository as code you own. No runtime UI package to depend on."
  seoTitle="shadcn components and pages for AI apps — Intelligo UI"
  description={`Intelligo UI: ${INTELLIGO.length} components for AI products, usable in any shadcn project, and ${REGISTRY_COUNT} product pages installed as your own source.`}
>
  <section class="xline">
    <div class="px-6 py-10 md:px-10 md:py-14">
      <ul class="grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-2">
        {DOORS.map((d) => (
          <li>
            <a href={d.href} class="group flex h-full flex-col bg-background p-6 no-underline transition-colors hover:bg-accent">
              <span class="flex items-baseline justify-between gap-4">
                <span class="heading text-[2.6rem] font-semibold leading-none tabular-nums text-foreground">{d.n}</span>
                <span class="mono text-[0.72rem] text-muted-foreground">{d.needs}</span>
              </span>
              <span class="mt-3 text-[1.1rem] font-semibold text-foreground">{d.title}</span>
              <span class="mt-2 text-[0.88rem] leading-snug text-foreground/70">{d.body}</span>
              <span class="mt-4 flex flex-wrap gap-1">
                {d.chips.map((c) => <span class="mono rounded-md border border-border px-1.5 py-0.5 text-[0.7rem] text-muted-foreground">{c}</span>)}
              </span>
              <span class="mono mt-auto pt-6 text-[0.72rem] text-muted-foreground transition-colors group-hover:text-foreground">{d.cta} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="xline">
    <div class="grid gap-x-12 gap-y-6 px-6 py-10 md:px-10 md:py-14 lg:grid-cols-[1fr_2fr]">
      <div class="section-head">
        <span class="tag">install</span>
        <h2>One command per piece</h2>
        <p>Start with the base item — the token contract and the base-nova config — then add what you need. A page brings the components it is built from.</p>
        <p class="mt-2">An app made by <code class="mono text-[0.8rem]">create</code> already names the registry. In any other shadcn project, add it to <code class="mono text-[0.8rem]">components.json</code> first:</p>
      </div>
      <div class="flex flex-col gap-2">
        <pre class="mono overflow-x-auto rounded-lg border border-border bg-muted px-3 py-2 text-xs text-foreground/80">{`"registries": { "@intelligo": "${SITE.registryBase}/{name}.json" }`}</pre>
        <CopyLine cmd={installCommand("intelligo")} />
        <CopyLine cmd={installCommand("ai-message")} />
        <CopyLine cmd={installCommand("chat")} />
        <p class="mono mt-2 text-[0.75rem] text-muted-foreground"><a href="/docs/registry" class="hover:text-foreground">installing, in the docs →</a></p>
      </div>
    </div>
  </section>
</Page>
